{%- comment -%}
  SOURCE for sections/loftrest-about.liquid. Edit this file, then run
  `python3 build_pages.py` in the shopify folder.
  The story text lives in section settings so the owner can edit it in the theme editor.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign product = s.product -%}

<!-- HERO -->
<section class="relative overflow-hidden bg-gradient-to-br from-brand-indigo via-brand-royal to-brand-blue text-white">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 items-stretch">
    <div class="px-4 py-14 md:py-20 lg:pr-12 flex flex-col justify-center order-2 lg:order-1">
      <p class="text-sky-300 font-bold text-sm uppercase tracking-wide">Our story</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-extrabold tracking-tight leading-tight">{{ s.heading | escape }}</h1>
      <p class="mt-5 text-lg text-sky-100 max-w-xl whitespace-pre-line">{{ s.intro | escape }}</p>
    </div>
    <div class="relative min-h-[300px] lg:min-h-[520px] order-1 lg:order-2">
      <!--SLOT id="hero_image" label="Family or founder photo" wrap="absolute inset-0" sizes="(min-width: 1024px) 50vw, 100vw" eager-->
    </div>
  </div>
</section>

<!-- ME: LONG WORKDAYS -->
<section class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
    <div class="relative aspect-[4/5] rounded-3xl overflow-hidden">
      <!--SLOT id="me_image" label="Photo of you (or your workday)" wrap="absolute inset-0" sizes="(min-width: 768px) 560px, 100vw"-->
    </div>
    <div>
      <p class="text-brand-royal font-bold text-sm uppercase tracking-wide">{{ s.me_label | escape }}</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight">{{ s.me_heading | escape }}</h2>
      <p class="mt-5 text-lg text-slate-700 leading-relaxed whitespace-pre-line">{{ s.me_text | escape }}</p>
    </div>
  </div>
</section>

<!-- HER: RESTLESS NIGHTS -->
<section class="py-16 md:py-24 bg-white border-y border-slate-200">
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
    <div class="md:order-2 relative aspect-[4/5] rounded-3xl overflow-hidden">
      <!--SLOT id="her_image" label="Photo of her (or your evenings)" wrap="absolute inset-0" sizes="(min-width: 768px) 560px, 100vw"-->
    </div>
    <div class="md:order-1">
      <p class="text-brand-royal font-bold text-sm uppercase tracking-wide">{{ s.her_label | escape }}</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight">{{ s.her_heading | escape }}</h2>
      <p class="mt-5 text-lg text-slate-700 leading-relaxed whitespace-pre-line">{{ s.her_text | escape }}</p>
    </div>
  </div>
</section>

<!-- TURNING POINT QUOTE -->
<section class="py-16 md:py-24 bg-brand-indigo text-white">
  <div class="max-w-3xl mx-auto px-4 text-center">
    <i data-lucide="quote" class="w-10 h-10 mx-auto text-sky-400"></i>
    <blockquote class="mt-6 text-2xl md:text-3xl font-extrabold leading-snug">{{ s.quote | escape }}</blockquote>
    <p class="mt-6 text-sky-200 font-semibold">{% if s.founder_name != blank %}{{ s.founder_name | escape }}, founder of LoftRest™{% else %}Founder of LoftRest™{% endif %}</p>
  </div>
</section>

<!-- BUILDING THE REST -->
<section class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-2xl">
      <p class="text-brand-royal font-bold text-sm uppercase tracking-wide">Building LoftRest™</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight">{{ s.build_heading | escape }}</h2>
      <p class="mt-5 text-lg text-slate-700 leading-relaxed whitespace-pre-line">{{ s.build_text | escape }}</p>
    </div>
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-5 gap-8 items-center">
      <ol class="lg:col-span-2 space-y-6">
        <li class="flex gap-4"><span class="w-11 h-11 shrink-0 rounded-full bg-brand-royal text-white font-extrabold flex items-center justify-center">1</span><span><strong class="block text-brand-navy text-lg">The headrest first</strong><span class="text-slate-600">Contoured, high-density memory foam with a soft flannel cover, shaped to support the neck all night.</span></span></li>
        <li class="flex gap-4"><span class="w-11 h-11 shrink-0 rounded-full bg-brand-royal text-white font-extrabold flex items-center justify-center">2</span><span><strong class="block text-brand-navy text-lg">Then the wind-down</strong><span class="text-slate-600">Gentle air traction, soothing warmth and light massage for a relaxing 15&ndash;30 minutes before sleep.</span></span></li>
        <li class="flex gap-4"><span class="w-11 h-11 shrink-0 rounded-full bg-brand-royal text-white font-extrabold flex items-center justify-center">3</span><span><strong class="block text-brand-navy text-lg">Safe to drift off on</strong><span class="text-slate-600">An automatic shut-off timer and low-voltage USB power, so you can fall asleep without a second thought.</span></span></li>
      </ol>
      <div class="lg:col-span-3 relative aspect-[4/3] rounded-3xl overflow-hidden">
        <!--SLOT id="build_image" label="Product or early design photo" wrap="absolute inset-0" sizes="(min-width: 1024px) 680px, 100vw"-->
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE STAND FOR -->
<section class="py-16 md:py-24 bg-gradient-to-b from-brand-indigo to-brand-royal text-white">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-center">What we stand for</h2>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded-2xl bg-white/10 p-6"><i data-lucide="heart-handshake" class="w-8 h-8 text-sky-300"></i><h3 class="mt-4 text-xl font-bold">Made for the people we love</h3><p class="mt-2 text-sky-100">We design every LoftRest™ as if it's going in our own bedroom, because that's where it started.</p></div>
      <div class="rounded-2xl bg-white/10 p-6"><i data-lucide="badge-check" class="w-8 h-8 text-sky-300"></i><h3 class="mt-4 text-xl font-bold">Honest, always</h3><p class="mt-2 text-sky-100">Real reviews only, no fake sales, and no promises we can't keep. LoftRest™ is a comfort product, and we say so.</p></div>
      <div class="rounded-2xl bg-white/10 p-6"><i data-lucide="mail" class="w-8 h-8 text-sky-300"></i><h3 class="mt-4 text-xl font-bold">Here to help</h3><p class="mt-2 text-sky-100">A small team you can actually reach, with 30-day change-of-mind returns and free standard shipping in Australia.</p></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-16 md:py-24">
  <div class="max-w-3xl mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight">{{ s.cta_heading | escape }}</h2>
    <p class="mt-4 text-lg text-slate-600">{{ s.cta_text | escape }}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      {%- if product != blank -%}<a href="{{ product.url }}" class="inline-flex items-center gap-2 bg-brand-royal hover:bg-brand-indigo text-white font-extrabold px-8 py-4 rounded-full shadow-lg transition-colors">Shop LoftRest™ <i data-lucide="arrow-right" class="w-5 h-5"></i></a>{%- endif -%}
      <a href="/pages/faq" class="inline-flex items-center gap-2 border-2 border-brand-royal text-brand-royal hover:bg-brand-lightBlue font-extrabold px-8 py-4 rounded-full transition-colors">Questions? Read our FAQ</a>
    </div>
  </div>
</section>
