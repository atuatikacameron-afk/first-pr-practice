{%- comment -%}
  SOURCE for sections/loftrest-faq.liquid. Edit this file, then run
  `python3 build_pages.py` in the shopify folder.
{%- endcomment -%}
{%- assign faqs = section.blocks | where: 'type', 'faq' -%}
{%- assign categories = '' -%}
{%- for block in faqs -%}
  {%- assign cat = block.settings.category | strip | default: 'General' -%}
  {%- assign wrapped = '|' | append: cat | append: '|' -%}
  {%- assign haystack = '|' | append: categories | append: '|' -%}
  {%- unless haystack contains wrapped -%}
    {%- if categories == '' -%}{%- assign categories = cat -%}{%- else -%}{%- assign categories = categories | append: '|' | append: cat -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign category_list = categories | split: '|' -%}
{%- assign support_email = section.settings.support_email | default: shop.email -%}
{%- assign product = section.settings.product -%}

<div class="pb-16">
  <!-- HEADER -->
  <header class="bg-brand-navy text-white">
    <div class="max-w-4xl mx-auto px-4 py-12 md:py-16 text-center">
      <p class="text-sky-400 font-bold text-sm uppercase tracking-wide">Help centre</p>
      <h1 class="mt-3 text-3xl md:text-5xl font-extrabold tracking-tight">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}<p class="mt-4 text-lg text-slate-300 max-w-2xl mx-auto">{{ section.settings.intro | escape }}</p>{%- endif -%}
      {%- if category_list.size > 1 -%}
      <nav class="mt-8 flex flex-wrap justify-center gap-2" aria-label="Question topics">
        {%- for cat in category_list -%}
        <a href="#topic-{{ cat | handleize }}" class="rounded-full bg-white/10 hover:bg-white/20 px-4 py-2 text-sm font-semibold transition-colors">{{ cat | escape }}</a>
        {%- endfor -%}
      </nav>
      {%- endif -%}
    </div>
  </header>

  <!-- QUESTIONS BY TOPIC -->
  <div class="max-w-3xl mx-auto px-4">
    {%- for cat in category_list -%}
    <section id="topic-{{ cat | handleize }}" class="pt-12 scroll-mt-20">
      <h2 class="text-2xl md:text-3xl font-extrabold text-brand-navy tracking-tight">{{ cat | escape }}</h2>
      <div class="mt-6 space-y-3">
        {%- for block in faqs -%}
          {%- assign block_cat = block.settings.category | strip | default: 'General' -%}
          {%- if block_cat == cat -%}
          <details class="group rounded-xl border border-slate-200 bg-white p-5" {{ block.shopify_attributes }}>
            <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-brand-navy list-none">
              <h3>{{ block.settings.question | escape }}</h3>
              <i data-lucide="chevron-down" class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180"></i>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed whitespace-pre-line">{{ block.settings.answer | escape }}</p>
          </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endfor -%}
  </div>

  <!-- STILL HAVE A QUESTION? -->
  <section class="max-w-3xl mx-auto px-4 pt-16">
    <div class="rounded-3xl bg-brand-lightBlue p-6 md:p-10 grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
      <div>
        <h2 class="text-2xl font-extrabold text-brand-navy">Still have a question?</h2>
        <p class="mt-2 text-slate-700">We're happy to help before and after you buy.</p>
      </div>
      <ul class="space-y-3 text-slate-700">
        {%- if support_email != blank -%}
        <li class="flex items-center gap-3"><i data-lucide="mail" class="w-5 h-5 shrink-0 text-brand-blue"></i> <a href="mailto:{{ support_email }}" class="underline font-semibold">{{ support_email }}</a></li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
        <li class="flex items-center gap-3"><i data-lucide="phone" class="w-5 h-5 shrink-0 text-brand-blue"></i> <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="underline font-semibold">{{ section.settings.phone | escape }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </section>

  <!-- POLICIES -->
  {%- if shop.shipping_policy.url != blank or shop.refund_policy.url != blank or shop.terms_of_service.url != blank -%}
  <section class="max-w-3xl mx-auto px-4 pt-8">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
      {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}" class="underline">Shipping policy</a></li>{%- endif -%}
      {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}" class="underline">Refund policy</a></li>{%- endif -%}
      {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}" class="underline">Terms of service</a></li>{%- endif -%}
      {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}" class="underline">Privacy policy</a></li>{%- endif -%}
    </ul>
  </section>
  {%- endif -%}

  <!-- PRODUCT CTA -->
  {%- if product != blank -%}
  <section class="max-w-3xl mx-auto px-4 pt-12 text-center">
    <h2 class="text-2xl font-extrabold text-brand-navy">Ready to try LoftRest™?</h2>
    <p class="mt-2 text-slate-600">{{ product.selected_or_first_available_variant.price | money }} &middot; Free standard shipping in Australia &middot; 30-day returns</p>
    <a href="{{ product.url }}" class="mt-5 inline-block bg-brand-blue hover:bg-sky-600 text-white font-extrabold px-8 py-4 rounded-xl shadow-lg transition-colors">Shop LoftRest™</a>
  </section>
  {%- endif -%}
</div>

{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faqs -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
