{%- comment -%}
  SOURCE for sections/loftrest-product.liquid. Edit this file, then run
  `python3 build_product.py` in the shopify folder. Classes here are plain Tailwind;
  the build adds the lr- prefix, inlines the icons and compiles the CSS.
  JavaScript class names must already carry the lr- prefix.
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if variant.compare_at_price > variant.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign reviews = section.blocks | where: 'type', 'review' -%}
{%- assign review_count = reviews | size -%}
{%- assign star_total = 0 -%}
{%- for r in reviews -%}{%- assign star_total = star_total | plus: r.settings.stars -%}{%- endfor -%}
{%- if review_count > 0 -%}{%- assign rating = star_total | times: 1.0 | divided_by: review_count | round: 1 -%}{%- endif -%}
{%- assign offers = section.blocks | where: 'type', 'offer' -%}
{%- assign support_email = section.settings.support_email | default: shop.email -%}

<div class="pb-24 md:pb-0">

  <!-- ABOVE THE FOLD: gallery + buy box -->
  <section class="max-w-6xl mx-auto px-4 pt-6 md:pt-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">

    <!-- Gallery -->
    <div>
      <div class="relative aspect-square rounded-2xl overflow-hidden bg-white border border-slate-200">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', id: 'lr-main-image', loading: 'eager', fetchpriority: 'high' }}
        {%- endif -%}
        {%- if on_sale -%}
        <span class="absolute top-4 left-4 bg-brand-heat text-white text-xs font-bold px-2.5 py-1 rounded-full">SAVE {{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}%</span>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
      <div class="mt-3 grid grid-cols-5 gap-2">
        {%- for media in product.media limit: 10 -%}
          {%- if media.media_type == 'image' -%}
          <button type="button" data-lr-thumb="{{ media | image_url: width: 1400 }}" data-lr-alt="{{ media.alt | escape }}" aria-label="Show image {{ forloop.index }}" class="aspect-square rounded-lg overflow-hidden border border-slate-200 hover:border-brand-blue">
            {{ media | image_url: width: 200 | image_tag: class: 'lr-w-full lr-h-full lr-object-cover', loading: 'lazy' }}
          </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>

    <!-- Buy box -->
    <div>
      <p class="text-brand-blue font-bold text-xs uppercase tracking-wide">{{ product.vendor | escape }}</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight">{{ product.title | escape }}</h1>

      {%- if review_count > 0 -%}
      <a href="#reviews" class="mt-3 inline-flex items-center gap-2 text-sm text-slate-600">
        {%- assign rating_rounded = rating | round -%}
        <span class="flex" aria-hidden="true">{%- for i in (1..5) -%}{%- if i <= rating_rounded -%}<i data-lucide="star" class="w-4 h-4 fill-current text-amber-400"></i>{%- else -%}<i data-lucide="star" class="w-4 h-4 text-slate-300"></i>{%- endif -%}{%- endfor -%}</span>
        <span><strong class="text-brand-navy">{{ rating }}</strong> from {{ review_count }} review{% if review_count != 1 %}s{% endif %}</span>
      </a>
      {%- endif -%}

      <p class="mt-4 text-slate-600 text-lg">{{ section.settings.subtitle | escape }}</p>

      <div class="mt-5 flex flex-wrap items-baseline gap-3">
        <span class="text-3xl font-extrabold text-brand-navy">{{ variant.price | money }}</span>
        {%- if on_sale -%}
        <span class="text-lg text-slate-400 line-through">{{ variant.compare_at_price | money }}</span>
        <span class="text-xs font-bold bg-brand-heat text-white px-2 py-1 rounded">SAVE {{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      </div>
      <p class="mt-1 text-xs text-slate-500">{% if cart.taxes_included %}Tax included. {% endif %}Shipping calculated at checkout.</p>

      <ul class="mt-6 space-y-2.5 text-slate-700">
        <li class="flex gap-3"><i data-lucide="wind" class="w-5 h-5 shrink-0 text-brand-blue"></i> Pneumatic air traction for a gentle, relaxing stretch</li>
        <li class="flex gap-3"><i data-lucide="flame" class="w-5 h-5 shrink-0 text-brand-heat"></i> Constant-temperature heat for soothing warmth</li>
        <li class="flex gap-3"><i data-lucide="activity" class="w-5 h-5 shrink-0 text-brand-emerald"></i> Micro-kinetic massage modes</li>
        <li class="flex gap-3"><i data-lucide="moon" class="w-5 h-5 shrink-0 text-brand-navy"></i> Memory foam pillow for all-night support</li>
      </ul>

      {%- form 'product', product, id: 'lr-product-form', class: 'lr-mt-6' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="return_to" id="lr-return-to" value="{% if section.settings.go_to_checkout %}/checkout{% else %}{{ routes.cart_url }}{% endif %}">

        {%- if offers.size > 0 -%}
        <fieldset class="space-y-3">
          <legend class="font-bold text-brand-navy mb-3">Choose your offer</legend>
          {%- for block in offers -%}
            {%- assign qty = block.settings.quantity -%}
            {%- assign bundle_price = variant.price | times: qty -%}
            {%- assign use_discount = false -%}
            {%- if block.settings.discount_percent > 0 and block.settings.discount_code != blank -%}{%- assign use_discount = true -%}{%- endif -%}
            {%- if use_discount -%}
              {%- assign off = bundle_price | times: block.settings.discount_percent | divided_by: 100 -%}
              {%- assign bundle_final = bundle_price | minus: off -%}
            {%- endif -%}
          <label class="flex items-center gap-4 rounded-xl border-2 border-slate-200 p-4 cursor-pointer has-[:checked]:border-brand-blue has-[:checked]:bg-brand-lightBlue/40" {{ block.shopify_attributes }}>
            <input type="radio" name="lr-offer" class="accent-brand-blue w-4 h-4" value="{{ qty }}" data-code="{% if use_discount %}{{ block.settings.discount_code | escape }}{% endif %}" {% if forloop.first %}checked{% endif %}>
            <span class="flex-1">
              <span class="block font-bold text-brand-navy">{{ block.settings.label | escape }}</span>
              {%- if block.settings.note != blank -%}<span class="block text-sm text-slate-500">{{ block.settings.note | escape }}</span>{%- endif -%}
            </span>
            <span class="text-right">
              {%- if use_discount -%}
              <span class="block font-extrabold text-brand-navy">{{ bundle_final | money }}</span>
              <span class="block text-xs text-slate-400 line-through">{{ bundle_price | money }}</span>
              {%- else -%}
              <span class="block font-extrabold text-brand-navy">{{ bundle_price | money }}</span>
              {%- endif -%}
            </span>
            {%- if block.settings.badge != blank -%}<span class="text-xs font-bold bg-brand-emerald text-white px-2 py-1 rounded">{{ block.settings.badge | escape }}</span>{%- endif -%}
          </label>
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" id="lr-qty" value="{{ offers.first.settings.quantity | default: 1 }}">
        {%- else -%}
        <input type="hidden" name="quantity" id="lr-qty" value="1">
        {%- endif -%}

        <button type="submit" id="lr-add" {% unless variant.available %}disabled{% endunless %} class="mt-5 w-full bg-brand-blue hover:bg-sky-600 disabled:opacity-50 text-white font-extrabold text-lg px-8 py-4 rounded-xl shadow-lg transition-colors">
          {%- if variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
        <div class="mt-3">{{ form | payment_button }}</div>
      {%- endform -%}

      <!-- Trust row: only facts that are true for this store -->
      <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-700">
        <li class="flex items-center gap-2"><i data-lucide="lock" class="w-4 h-4 text-brand-emerald"></i> Secure checkout by Shopify</li>
        {%- if section.settings.shipping_note != blank -%}
        <li class="flex items-center gap-2"><i data-lucide="truck" class="w-4 h-4 text-brand-emerald"></i> {{ section.settings.shipping_note | escape }}</li>
        {%- endif -%}
        {%- if section.settings.show_trial -%}
        <li class="flex items-center gap-2"><i data-lucide="shield-check" class="w-4 h-4 text-brand-emerald"></i> {{ section.settings.trial_days }}-night trial</li>
        {%- endif -%}
        {%- if shop.refund_policy.url != blank -%}
        <li class="flex items-center gap-2"><i data-lucide="undo-2" class="w-4 h-4 text-brand-emerald"></i> <a href="{{ shop.refund_policy.url }}" class="underline">{{ section.settings.returns_label | default: 'Returns and refunds' | escape }}</a></li>
        {%- endif -%}
      </ul>
      {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Accepted payment methods">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'lr-h-6 lr-w-auto' }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="mt-12 bg-brand-navy text-white">
    <div class="max-w-6xl mx-auto px-4 py-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div class="flex items-center gap-3"><i data-lucide="timer-off" class="w-6 h-6 shrink-0 text-sky-400"></i> Automatic shut-off timer</div>
      <div class="flex items-center gap-3"><i data-lucide="usb" class="w-6 h-6 shrink-0 text-sky-400"></i> Low-voltage 5V USB power</div>
      <div class="flex items-center gap-3"><i data-lucide="layers" class="w-6 h-6 shrink-0 text-sky-400"></i> High-density memory foam</div>
      <div class="flex items-center gap-3"><i data-lucide="lock" class="w-6 h-6 shrink-0 text-sky-400"></i> Secure Shopify checkout</div>
    </div>
  </section>

  <!-- DOES IT WORK? (honest explainer) -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <p class="text-brand-blue font-bold text-sm uppercase tracking-wide">How it works</p>
    <h2 class="mt-2 text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight">What is a cervical traction pillow?</h2>
    <div class="mt-6 space-y-4 text-lg text-slate-700 leading-relaxed">
      <p>A cervical traction pillow uses air chambers to give your neck a gentle, lengthening stretch while you lie back. Warmth and massage are two of the most popular ways people unwind at home.</p>
      <p>LoftRest™ puts all three into one device for a 15&ndash;30 minute relaxation session, then works as a contoured memory foam pillow you sleep on all night.</p>
      <p class="text-base text-slate-500">LoftRest™ is a comfort and relaxation product. It is not a medical device and is not designed to diagnose, treat or relieve any medical condition. If you have neck pain, see a health professional.</p>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="bg-white border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight text-center">How LoftRest™ compares</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[560px] text-left text-sm md:text-base">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-3 pr-4 font-semibold text-slate-500">Feature</th>
              <th class="py-3 px-3 font-extrabold text-brand-blue">LoftRest™</th>
              <th class="py-3 px-3 font-semibold text-slate-600">Memory foam pillow</th>
              <th class="py-3 px-3 font-semibold text-slate-600">Foam neck stretcher</th>
              <th class="py-3 pl-3 font-semibold text-slate-600">Heat pack</th>
            </tr>
          </thead>
          <tbody class="text-slate-700">
            <tr class="border-b border-slate-100"><td class="py-3 pr-4">Air traction (adjustable stretch)</td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td><td class="py-3 px-3 text-slate-500">Fixed shape</td><td class="py-3 pl-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td></tr>
            <tr class="border-b border-slate-100"><td class="py-3 pr-4">Built-in heat</td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td><td class="py-3 pl-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td></tr>
            <tr class="border-b border-slate-100"><td class="py-3 pr-4">Massage modes</td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td><td class="py-3 pl-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td></tr>
            <tr class="border-b border-slate-100"><td class="py-3 pr-4">Sleep on it all night</td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td><td class="py-3 pl-3"><i data-lucide="x" class="w-5 h-5 text-slate-300"></i></td></tr>
            <tr><td class="py-3 pr-4">Automatic shut-off</td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 text-brand-emerald"></i></td><td class="py-3 px-3 text-slate-500">n/a</td><td class="py-3 px-3 text-slate-500">n/a</td><td class="py-3 pl-3 text-slate-500">Varies</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SPECS + SAFETY -->
  <section class="max-w-5xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="rounded-2xl bg-white border border-slate-200 p-6">
      <h2 class="text-2xl font-extrabold text-brand-navy">Specifications</h2>
      <dl class="mt-5 space-y-4 text-slate-700">
        <div class="flex gap-3"><i data-lucide="ruler" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><dt class="font-semibold text-brand-navy">Size</dt><dd>42.5 &times; 27 cm (16.7 &times; 10.6 in)</dd></div></div>
        <div class="flex gap-3"><i data-lucide="layers" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><dt class="font-semibold text-brand-navy">Pillow</dt><dd>High-density contoured memory foam</dd></div></div>
        <div class="flex gap-3"><i data-lucide="cloud" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><dt class="font-semibold text-brand-navy">Cover</dt><dd>Soft, breathable flannel</dd></div></div>
        <div class="flex gap-3"><i data-lucide="usb" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><dt class="font-semibold text-brand-navy">Power</dt><dd>5V USB. Works with a USB wall adapter, laptop or power bank.</dd></div></div>
        <div class="flex gap-3"><i data-lucide="timer-off" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><dt class="font-semibold text-brand-navy">Safety</dt><dd>Built-in automatic shut-off timer</dd></div></div>
        <div class="flex gap-3"><i data-lucide="zap" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><dt class="font-semibold text-brand-navy">Modes</dt><dd>Air traction, constant-temperature heat, micro-kinetic massage</dd></div></div>
      </dl>
    </div>
    <div class="rounded-2xl bg-amber-50 border border-amber-200 p-6">
      <h2 class="flex items-center gap-2 text-2xl font-extrabold text-brand-navy"><i data-lucide="info" class="w-6 h-6 text-amber-500"></i> Safe use</h2>
      <ul class="mt-5 space-y-3 text-slate-700">
        <li>Start on the gentlest setting and build up gradually.</li>
        <li>Stop if you feel sharp pain, numbness, tingling or dizziness.</li>
        <li>Talk to your doctor first if you are pregnant, have had neck or spine surgery, or have osteoporosis, a recent neck injury, rheumatoid arthritis, a spinal condition or a circulation disorder.</li>
        <li>LoftRest™ is a comfort and relaxation product, not a medical device.</li>
      </ul>
    </div>
  </section>

  <!-- REVIEWS: genuine reviews only (review blocks or a review app block) -->
  {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
  {%- if review_count > 0 or app_blocks.size > 0 -%}
  <section id="reviews" class="bg-white border-t border-slate-200 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight text-center">Customer reviews</h2>
      {%- if review_count > 0 -%}
      <p class="mt-3 text-center text-slate-600"><strong class="text-brand-navy">{{ rating }} out of 5</strong> from {{ review_count }} review{% if review_count != 1 %}s{% endif %}</p>
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {%- for block in reviews -%}
        <figure class="rounded-2xl border border-slate-200 p-6 flex flex-col" {{ block.shopify_attributes }}>
          <div class="flex text-amber-400" aria-label="{{ block.settings.stars }} out of 5 stars">{%- for i in (1..block.settings.stars) -%}<i data-lucide="star" class="w-4 h-4 fill-current"></i>{%- endfor -%}</div>
          {%- if block.settings.title != blank -%}<h3 class="mt-3 font-bold text-brand-navy">{{ block.settings.title | escape }}</h3>{%- endif -%}
          <blockquote class="mt-2 text-slate-600 flex-1">{{ block.settings.review | escape }}</blockquote>
          <figcaption class="mt-4 text-sm font-semibold text-slate-800">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="inline-flex items-center gap-1 font-normal text-brand-emerald"><i data-lucide="badge-check" class="w-4 h-4"></i> Verified buyer</span>{% endif %}</figcaption>
        </figure>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- for block in app_blocks -%}<div class="mt-10">{% render block %}</div>{%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  <!-- FAQ -->
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight text-center">Questions before you buy</h2>
    <div class="mt-10 space-y-3">
      {%- for block in faqs -%}
      <details class="group rounded-xl border border-slate-200 bg-white p-5" {{ block.shopify_attributes }}>
        <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-brand-navy list-none">
          <h3>{{ block.settings.question | escape }}</h3>
          <i data-lucide="chevron-down" class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180"></i>
        </summary>
        <p class="mt-3 text-slate-600 leading-relaxed">{{ block.settings.answer | escape }}</p>
      </details>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  <!-- POLICIES & CONTACT -->
  <section class="bg-white border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-slate-700">
      <div class="flex gap-3"><i data-lucide="mail" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><p class="font-bold text-brand-navy">Questions?</p>{%- if support_email != blank -%}<p class="mt-1">Email us at <a href="mailto:{{ support_email }}" class="underline">{{ support_email }}</a></p>{%- endif -%}</div></div>
      <div class="flex gap-3"><i data-lucide="truck" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><p class="font-bold text-brand-navy">Shipping</p><p class="mt-1">{%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}" class="underline">Read our shipping policy</a>{%- else -%}{{ section.settings.shipping_note | default: 'Shipping options are shown at checkout.' | escape }}{%- endif -%}</p></div></div>
      <div class="flex gap-3"><i data-lucide="undo-2" class="w-5 h-5 shrink-0 text-brand-blue"></i><div><p class="font-bold text-brand-navy">Returns</p><p class="mt-1">{%- if shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}" class="underline">Read our refund policy</a>{%- else -%}Contact us about returns.{%- endif -%}</p></div></div>
    </div>
  </section>

  <!-- STICKY ADD TO CART (mobile) -->
  <div class="md:hidden fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 backdrop-blur-md">
    <div class="px-4 py-3 flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="font-bold text-brand-navy truncate text-sm">{{ product.title | escape }}</p>
        <p class="text-sm"><span class="font-extrabold text-brand-navy">{{ variant.price | money }}</span>{%- if on_sale -%} <span class="text-slate-400 line-through">{{ variant.compare_at_price | money }}</span>{%- endif -%}</p>
      </div>
      <button type="submit" form="lr-product-form" {% unless variant.available %}disabled{% endunless %} class="shrink-0 bg-brand-blue hover:bg-sky-600 disabled:opacity-50 text-white font-extrabold px-5 py-3 rounded-xl shadow-lg">Add to cart</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('loftrest-{{ section.id }}');
    if (!root) return;
    // Gallery thumbnails
    var main = root.querySelector('#lr-main-image');
    root.querySelectorAll('[data-lr-thumb]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!main) return;
        main.removeAttribute('srcset');
        main.src = btn.dataset.lrThumb;
        main.alt = btn.dataset.lrAlt || '';
      });
    });
    // Offers: set quantity and apply the matching discount code at checkout
    var qty = root.querySelector('#lr-qty');
    var returnTo = root.querySelector('#lr-return-to');
    var base = returnTo ? returnTo.value : '/checkout';
    function applyOffer(input) {
      if (!input || !qty) return;
      qty.value = input.value;
      if (returnTo) returnTo.value = input.dataset.code ? '/discount/' + encodeURIComponent(input.dataset.code) + '?redirect=' + encodeURIComponent(base) : base;
    }
    root.querySelectorAll('input[name="lr-offer"]').forEach(function (input) {
      input.addEventListener('change', function () { applyOffer(input); });
    });
    applyOffer(root.querySelector('input[name="lr-offer"]:checked'));
  })();
</script>

<script type="application/ld+json">{{ product | structured_data }}</script>
{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faqs -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
