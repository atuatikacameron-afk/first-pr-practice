          <tr class="border-t border-white/10"><td class="py-3 pr-4">Gentle air traction</td><td class="py-3 px-3 bg-white/15"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 mx-auto text-white/40"></i></td><td class="py-3 pl-3"><i data-lucide="x" class="w-5 h-5 mx-auto text-white/40"></i></td></tr>
          <tr class="border-t border-white/10"><td class="py-3 pr-4">Built-in warmth</td><td class="py-3 px-3 bg-white/15"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 mx-auto text-white/40"></i></td><td class="py-3 pl-3"><i data-lucide="x" class="w-5 h-5 mx-auto text-white/40"></i></td></tr>
          <tr class="border-t border-white/10"><td class="py-3 pr-4">Massage modes</td><td class="py-3 px-3 bg-white/15"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td><td class="py-3 px-3"><i data-lucide="x" class="w-5 h-5 mx-auto text-white/40"></i></td><td class="py-3 pl-3"><i data-lucide="x" class="w-5 h-5 mx-auto text-white/40"></i></td></tr>
          <tr class="border-t border-white/10"><td class="py-3 pr-4">Automatic shut-off timer</td><td class="py-3 px-3 bg-white/15"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td><td class="py-3 px-3 text-center text-sky-100">n/a</td><td class="py-3 pl-3 text-center text-sky-100">n/a</td></tr>
          <tr class="border-t border-white/10"><td class="py-3 pr-4">Sleep on it all night</td><td class="py-3 px-3 bg-white/15 rounded-b-2xl"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td><td class="py-3 px-3"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td><td class="py-3 pl-3"><i data-lucide="check" class="w-5 h-5 mx-auto text-emerald-300"></i></td></tr>
        </tbody>
      </table>
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm">
      <li class="flex items-center gap-2"><i data-lucide="truck" class="w-5 h-5 text-sky-300"></i> Free standard shipping in Australia</li>
      <li class="flex items-center gap-2"><i data-lucide="undo-2" class="w-5 h-5 text-sky-300"></i> 30-day returns</li>
    </ul>
  </div>
</section>

<!-- REVIEWS (only genuine reviews) -->
{%- if review_count > 0 -%}
<section class="py-16 md:py-20 bg-white">
  <h2 class="px-4 text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight text-center">What customers say</h2>
  <div class="mt-10 flex gap-4 overflow-x-auto snap-x snap-mandatory px-4 pb-4 max-w-7xl mx-auto">
    {%- for block in reviews -%}
    <figure class="snap-start shrink-0 w-72 md:w-80 rounded-2xl border border-slate-200 bg-white flex flex-col overflow-hidden" {{ block.shopify_attributes }}>
      {%- if block.settings.photo != blank -%}{{ block.settings.photo | image_url: width: 640 | image_tag: widths: '320, 480, 640', sizes: '320px', class: 'lr-w-full lr-aspect-[4/3] lr-object-cover', loading: 'lazy', alt: block.settings.photo.alt }}{%- endif -%}
      <div class="p-5 flex flex-col flex-1">
        {%- if block.settings.stars > 0 -%}<span class="mb-3 flex" aria-label="{{ block.settings.stars }} out of 5 stars">{%- for i in (1..5) -%}{%- if i <= block.settings.stars -%}<i data-lucide="star" class="w-4 h-4 fill-current text-amber-400"></i>{%- else -%}<i data-lucide="star" class="w-4 h-4 text-slate-300"></i>{%- endif -%}{%- endfor -%}</span>{%- endif -%}
        <i data-lucide="quote" class="w-6 h-6 text-brand-royal/30"></i>
        <blockquote class="mt-2 text-slate-600 flex-1">&ldquo;{{ block.settings.review | escape }}&rdquo;</blockquote>
        <figcaption class="mt-4 text-sm font-semibold text-slate-800">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="inline-flex items-center gap-1 font-normal text-brand-emerald"><i data-lucide="badge-check" class="w-4 h-4"></i> Verified buyer</span>{% endif %}{% if block.settings.source != blank %}<span class="block mt-0.5 text-xs font-normal text-slate-500">{{ block.settings.source | escape }}</span>{% endif %}</figcaption>
      </div>
    </figure>
    {%- endfor -%}
  </div>
  <p class="mt-6 text-center"><a href="/pages/reviews" class="font-semibold text-brand-royal underline">Read all reviews</a></p>
</section>
{%- endif -%}

<!-- TRUST MARQUEE -->
<div class="overflow-hidden bg-brand-lightBlue border-y border-sky-200 py-4" aria-label="Free standard shipping in Australia, 30-day returns, secure checkout">
  <div class="lr-marquee flex w-max gap-10 text-sm font-semibold text-brand-navy" aria-hidden="true">
    {%- for i in (1..2) -%}
      {%- for j in (1..4) -%}
      <span class="flex items-center gap-2"><i data-lucide="truck" class="w-4 h-4 text-brand-royal"></i> Free standard shipping in Australia</span>
      <span class="flex items-center gap-2"><i data-lucide="undo-2" class="w-4 h-4 text-brand-royal"></i> 30-day returns</span>
      <span class="flex items-center gap-2"><i data-lucide="lock" class="w-4 h-4 text-brand-royal"></i> Secure checkout</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<!-- FAQ -->
{%- if faqs.size > 0 -%}
<section class="py-16 md:py-24">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight text-center">Frequently asked questions</h2>
    <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
      {%- for block in faqs -%}
      <details class="group py-5" {{ block.shopify_attributes }}>
        <summary class="flex items-center justify-between gap-4 cursor-pointer font-bold text-brand-navy list-none"><h3>{{ block.settings.question | escape }}</h3><i data-lucide="plus" class="w-5 h-5 shrink-0 text-brand-royal transition-transform group-open:rotate-45"></i></summary>
        <p class="mt-3 text-slate-600 leading-relaxed">{{ block.settings.answer | escape }}</p>
      </details>
      {%- endfor -%}
    </div>
    <p class="mt-6 text-center"><a href="/pages/faq" class="font-semibold text-brand-royal underline">See all questions</a></p>
  </div>
</section>
{%- endif -%}

<!-- FINAL CTA -->
<section class="pb-16 md:pb-24">
  <div class="max-w-5xl mx-auto px-4">
    <div class="rounded-3xl bg-gradient-to-br from-brand-indigo via-brand-royal to-brand-blue text-white p-8 md:p-12 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Relax first. Then sleep, supported.</h2>
      {%- if variant -%}<p class="mt-3 text-sky-100">{{ variant.price | money }} &middot; Free standard shipping in Australia &middot; 30-day returns</p>{%- endif -%}
      <a href="#offers" class="mt-8 inline-flex items-center gap-2 bg-white text-brand-royal hover:bg-sky-50 font-extrabold px-8 py-4 rounded-full shadow-lg transition-colors">Shop LoftRest™ <i data-lucide="arrow-right" class="w-5 h-5"></i></a>
    </div>
  </div>
</section>

{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faqs -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
