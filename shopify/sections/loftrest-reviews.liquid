-weight:600}.loftrest .lr-uppercase{text-transform:uppercase}.loftrest .lr-tracking-tight{letter-spacing:-.025em}.loftrest .lr-tracking-wide{letter-spacing:.025em}.loftrest .lr-text-amber-400{--tw-text-opacity:1;color:rgb(251 191 36/var(--tw-text-opacity,1))}.loftrest .lr-text-brand-blue{--tw-text-opacity:1;color:rgb(2 132 199/var(--tw-text-opacity,1))}.loftrest .lr-text-brand-emerald{--tw-text-opacity:1;color:rgb(16 185 129/var(--tw-text-opacity,1))}.loftrest .lr-text-brand-navy{--tw-text-opacity:1;color:rgb(15 23 42/var(--tw-text-opacity,1))}.loftrest .lr-text-brand-royal\/30{color:rgba(47,74,208,.3)}.loftrest .lr-text-sky-400{--tw-text-opacity:1;color:rgb(56 189 248/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-300{--tw-text-opacity:1;color:rgb(203 213 225/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-400{--tw-text-opacity:1;color:rgb(148 163 184/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-500{--tw-text-opacity:1;color:rgb(100 116 139/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-600{--tw-text-opacity:1;color:rgb(71 85 105/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-800{--tw-text-opacity:1;color:rgb(30 41 59/var(--tw-text-opacity,1))}.loftrest .lr-text-white{--tw-text-opacity:1;color:rgb(255 255 255/var(--tw-text-opacity,1))}.loftrest .lr-shadow-lg{--tw-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -4px rgba(0,0,0,.1);--tw-shadow-colored:0 10px 15px -3px var(--tw-shadow-color),0 4px 6px -4px var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow,0 0 #0000),var(--tw-ring-shadow,0 0 #0000),var(--tw-shadow)}.loftrest .lr-transition-colors{transition-property:color,background-color,border-color,text-decoration-color,fill,stroke;transition-timing-function:cubic-bezier(.4,0,.2,1);transition-duration:.15s}.loftrest .hover\:lr-bg-sky-600:hover{--tw-bg-opacity:1;background-color:rgb(2 132 199/var(--tw-bg-opacity,1))}@media (min-width:640px){