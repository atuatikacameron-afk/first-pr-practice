          {%- assign img = section.settings.image_middle | default: product.featured_image -%}{%- assign img_alt = img.alt | default: 'Woman relaxing on the LoftRest cervical traction pillow with the heat mode on' -%}{{ img | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 768px) 720px, 100vw', class: 'lr-w-full lr-aspect-square lr-object-cover lr-rounded-2xl', loading: 'lazy', alt: img_alt }}
