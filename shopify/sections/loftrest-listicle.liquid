            <h3 class="lr-mt-2 lr-text-xl lr-font-bold lr-text-brand-navy">Restorative sleep</h3>
            <p class="lr-mt-2 lr-text-slate-700">The timer switches the heat, stretch and massage off and you stay put, cradled by high-density contoured memory foam that supports your neck all night.</p>
          </div>
        </div>
        <!-- IMAGE 2 (middle): the product in action -->
        {%- if section.settings.image_middle != blank or product.featured_image != blank -%}
