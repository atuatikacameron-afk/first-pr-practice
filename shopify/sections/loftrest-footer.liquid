<div class="loftrest" id="loftrest-{{ section.id }}">
{%- assign support_email = section.settings.support_email | default: shop.email -%}
{%- assign product = section.settings.product -%}

<footer class="lr-bg-brand-navy lr-text-slate-300">

  <!-- TRUST STRIP -->
  <div class="lr-border-b lr-border-white/10">
    <ul class="lr-max-w-7xl lr-mx-auto lr-px-4 lr-py-6 lr-grid lr-grid-cols-2 md:lr-grid-cols-4 lr-gap-4 lr-text-sm">
      <li class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg> <span><strong class="lr-block lr-text-white">Free shipping</strong>Standard, within Australia</span></li>
      <li class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" /></svg> <span><strong class="lr-block lr-text-white">30-day returns</strong>Change-of-mind returns</span></li>
      <li class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> <span><strong class="lr-block lr-text-white">Secure checkout</strong>Processed by Shopify</span></li>
      <li class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M10 2h4" /><path d="M4.6 11a8 8 0 0 0 1.7 8.7 8 8 0 0 0 8.7 1.7" /><path d="M7.4 7.4a8 8 0 0 1 10.3 1 8 8 0 0 1 .9 10.2" /><path d="m2 2 20 20" /><path d="M12 12v-2" /></svg> <span><strong class="lr-block lr-text-white">Auto shut-off</strong>Built-in safety timer</span></li>
    </ul>
  </div>

  <!-- MAIN -->
  <div class="lr-max-w-7xl lr-mx-auto lr-px-4 lr-py-12 md:lr-py-16 lr-grid lr-grid-cols-2 lg:lr-grid-cols-12 lr-gap-x-6 lr-gap-y-10">

    <!-- Brand + newsletter -->
    <div class="lr-col-span-2 lg:lr-col-span-5">
      <a href="{{ routes.root_url }}" class="lr-inline-flex lr-items-center lr-gap-2" aria-label="{{ shop.name | escape }} home">
        <span class="lr-bg-brand-blue lr-text-white lr-p-2 lr-rounded-lg"><svg class="lr-w-6 lr-h-6" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg></span>
        <span class="lr-font-extrabold lr-text-2xl lr-tracking-tight lr-text-white">LOFTREST<span class="lr-text-sky-400">.</span></span>
      </a>
      <p class="lr-mt-4 lr-max-w-sm">{{ section.settings.tagline | escape }}</p>

      {%- if section.settings.show_newsletter -%}
      <div class="lr-mt-8 lr-max-w-md">
        <p class="lr-font-bold lr-text-white">{{ section.settings.newsletter_heading | escape }}</p>
        {%- form 'customer', id: 'lr-newsletter', class: 'lr-mt-3' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="lr-rounded-xl lr-bg-white/10 lr-px-4 lr-py-3 lr-text-white" role="status">Thanks for signing up. Check your inbox soon.</p>
          {%- else -%}
            <div class="lr-flex lr-gap-2">
              <label for="lr-newsletter-email" class="lr-sr-only">Email address</label>
              <input id="lr-newsletter-email" type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address" class="lr-flex-1 lr-min-w-0 lr-rounded-xl lr-bg-white lr-text-brand-navy lr-px-4 lr-py-3 lr-outline-none focus:lr-ring-2 focus:lr-ring-sky-400">
              <button type="submit" class="lr-shrink-0 lr-bg-brand-blue hover:lr-bg-sky-600 lr-text-white lr-font-bold lr-px-5 lr-py-3 lr-rounded-xl lr-transition-colors">Sign up</button>
            </div>
            {%- if form.errors -%}<div class="lr-mt-2 lr-text-sm lr-text-orange-300" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <p class="lr-mt-2 lr-text-xs lr-text-slate-400">By signing up you agree to receive emails from LoftRest™. Unsubscribe anytime. See our {% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}" class="lr-underline">privacy policy</a>{% else %}privacy policy{% endif %}.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- endif -%}
    </div>

    <!-- Shop -->
    <nav class="lg:lr-col-span-2" aria-label="Shop">
      <p class="lr-font-bold lr-text-white">Shop</p>
      <ul class="lr-mt-4 lr-space-y-3">
        {%- if product != blank -%}
        <li><a href="{{ product.url }}" class="hover:lr-text-white">LoftRest™ Pillow</a></li>
        <li><a href="{{ product.url }}" class="hover:lr-text-white">2-Pack (save 10%)</a></li>
        {%- endif -%}
        {%- for link in section.settings.shop_menu.links -%}<li><a href="{{ link.url }}" class="hover:lr-text-white">{{ link.title | escape }}</a></li>{%- endfor -%}
        {%- if section.settings.shop_menu == blank -%}
        <li><a href="/pages/5-reasons-loftrest" class="hover:lr-text-white">Why LoftRest™</a></li>
        <li><a href="/pages/reviews" class="hover:lr-text-white">Reviews</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Help -->
    <nav class="lg:lr-col-span-2" aria-label="Help">
      <p class="lr-font-bold lr-text-white">Help</p>
      <ul class="lr-mt-4 lr-space-y-3">
        {%- for link in section.settings.help_menu.links -%}<li><a href="{{ link.url }}" class="hover:lr-text-white">{{ link.title | escape }}</a></li>{%- endfor -%}
        {%- if section.settings.help_menu == blank -%}
        <li><a href="/pages/faq" class="hover:lr-text-white">FAQ</a></li>
        {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}" class="hover:lr-text-white">Shipping</a></li>{%- endif -%}
        {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}" class="hover:lr-text-white">Returns &amp; refunds</a></li>{%- endif -%}
        <li><a href="/pages/contact" class="hover:lr-text-white">Contact us</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Contact + legal -->
    <div class="lr-col-span-2 lg:lr-col-span-3">
      <p class="lr-font-bold lr-text-white">Get in touch</p>
      <ul class="lr-mt-4 lr-space-y-3">
        {%- if support_email != blank -%}<li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg> <a href="mailto:{{ support_email }}" class="hover:lr-text-white lr-break-all">{{ support_email }}</a></li>{%- endif -%}
        {%- if section.settings.phone != blank -%}<li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" /></svg> <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="hover:lr-text-white">{{ section.settings.phone | escape }}</a></li>{%- endif -%}
        {%- if section.settings.location != blank -%}<li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" /></svg> {{ section.settings.location | escape }}</li>{%- endif -%}
      </ul>
      {%- if shop.policies.size > 0 -%}
      <p class="lr-mt-8 lr-font-bold lr-text-white">Legal</p>
      <ul class="lr-mt-4 lr-space-y-2 lr-text-sm">
        {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}" class="hover:lr-text-white">{{ policy.title | escape }}</a></li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </div>

  <!-- BOTTOM BAR -->
  <div class="lr-border-t lr-border-white/10">
    <div class="lr-max-w-7xl lr-mx-auto lr-px-4 lr-py-6 lr-flex lr-flex-col md:lr-flex-row md:lr-items-center md:lr-justify-between lr-gap-5 lr-text-sm">
      <div class="lr-space-y-1">
        <p>&copy; {{ 'now' | date: '%Y' }} LoftRest™. All rights reserved.{% if section.settings.abn != blank %} ABN {{ section.settings.abn | escape }}.{% endif %}</p>
        <p class="lr-text-xs lr-text-slate-400">LoftRest™ is a comfort and relaxation product, not a medical device.</p>
      </div>
      <div class="lr-flex lr-flex-col md:lr-items-end lr-gap-4">
        {%- assign has_social = false -%}
        {%- if section.settings.instagram != blank or section.settings.tiktok != blank or section.settings.facebook != blank or section.settings.youtube != blank -%}{%- assign has_social = true -%}{%- endif -%}
        {%- if has_social -%}
        <ul class="lr-flex lr-flex-wrap lr-gap-2" aria-label="Follow LoftRest">
          {%- if section.settings.instagram != blank -%}<li><a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" class="lr-inline-block lr-rounded-full lr-border lr-border-white/20 lr-px-4 lr-py-1.5 hover:lr-bg-white/10">Instagram</a></li>{%- endif -%}
          {%- if section.settings.tiktok != blank -%}<li><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" class="lr-inline-block lr-rounded-full lr-border lr-border-white/20 lr-px-4 lr-py-1.5 hover:lr-bg-white/10">TikTok</a></li>{%- endif -%}
          {%- if section.settings.facebook != blank -%}<li><a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" class="lr-inline-block lr-rounded-full lr-border lr-border-white/20 lr-px-4 lr-py-1.5 hover:lr-bg-white/10">Facebook</a></li>{%- endif -%}
          {%- if section.settings.youtube != blank -%}<li><a href="{{ section.settings.youtube }}" target="_blank" rel="noopener" class="lr-inline-block lr-rounded-full lr-border lr-border-white/20 lr-px-4 lr-py-1.5 hover:lr-bg-white/10">YouTube</a></li>{%- endif -%}
        </ul>
        {%- endif -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="lr-flex lr-flex-wrap lr-gap-2" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'lr-h-6 lr-w-auto' }}</li>{%- endfor -%}
        </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>
</div>

{% schema %}
{
  "name": "LoftRest footer",
  "tag": "div",
  "class": "loftrest-section",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Relax first, then sleep. The 3-in-1 cervical traction pillow with air traction, heat, massage and all-night memory foam support."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product for the Shop button"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Signup heading",
      "default": "Get tips for better wind-downs and first access to offers"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu (optional)",
      "info": "Leave empty to show Why LoftRest and Reviews."
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Help menu (optional)",
      "info": "Leave empty to show FAQ, Shipping, Returns and Contact."
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "info": "Leave empty to use your store email."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "info": "e.g. Melbourne, Australia. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "abn",
      "label": "ABN",
      "info": "Shown next to the copyright. Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube"
    }
  ],
  "presets": [
    {
      "name": "LoftRest footer"
    }
  ]
}
{% endschema %}
