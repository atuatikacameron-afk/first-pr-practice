          {%- if block.settings.question != blank -%}<h3 class="lr-mt-1 lr-font-bold lr-text-brand-navy">{{ block.settings.question | escape }}</h3>{%- endif -%}
          <div class="lr-mt-3 lr-flex lr-text-amber-400" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..block.settings.stars) -%}<svg class="lr-w-4 lr-h-4 lr-fill-current" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>{%- endfor -%}
          </div>
          <blockquote class="lr-mt-3 lr-text-slate-600 lr-flex-1">{{ block.settings.review | escape }}</blockquote>
          <figcaption class="lr-mt-4 lr-text-sm lr-font-semibold lr-text-slate-800">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="lr-font-normal lr-text-slate-500">· Verified buyer</span>{% endif %}</figcaption>
        </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
