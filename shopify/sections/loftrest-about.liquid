<div class="loftrest" id="loftrest-{{ section.id }}">
{%- assign s = section.settings -%}
{%- assign product = s.product -%}

<!-- HERO -->
<section class="lr-relative lr-overflow-hidden lr-bg-gradient-to-br lr-from-brand-indigo lr-via-brand-royal lr-to-brand-blue lr-text-white">
  <div class="lr-max-w-7xl lr-mx-auto lr-grid lr-grid-cols-1 lg:lr-grid-cols-2 lr-items-stretch">
    <div class="lr-px-4 lr-py-14 md:lr-py-20 lg:lr-pr-12 lr-flex lr-flex-col lr-justify-center lr-order-2 lg:lr-order-1">
      <p class="lr-text-sky-300 lr-font-bold lr-text-sm lr-uppercase lr-tracking-wide">Our story</p>
      <h1 class="lr-mt-3 lr-text-4xl md:lr-text-5xl lr-font-extrabold lr-tracking-tight lr-leading-tight">{{ s.heading | escape }}</h1>
      <p class="lr-mt-5 lr-text-lg lr-text-sky-100 lr-max-w-xl lr-whitespace-pre-line">{{ s.intro | escape }}</p>
    </div>
    <div class="lr-relative lr-min-h-[300px] lg:lr-min-h-[520px] lr-order-1 lg:lr-order-2">
      <div class="lr-absolute lr-inset-0">{%- if section.settings.hero_image != blank -%}{%- assign img_alt = section.settings.hero_image.alt | default: 'LoftRest cervical traction pillow' -%}{{ section.settings.hero_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 1024px) 50vw, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', loading: 'eager', fetchpriority: 'high', alt: img_alt }}{%- else -%}<div class="lr-w-full lr-h-full lr-flex lr-flex-col lr-items-center lr-justify-center lr-gap-2 lr-p-4 lr-text-center lr-bg-gradient-to-br lr-from-brand-lightBlue lr-to-sky-100 lr-text-brand-royal">{%- if request.design_mode -%}<div class="lr-absolute lr-inset-3 lr-rounded-2xl lr-border-2 lr-border-dashed lr-border-sky-300"></div><svg class="lr-w-8 lr-h-8" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 5h6" /><path d="M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg><span class="lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">Add image: Family or founder photo</span>{%- else -%}<svg class="lr-w-10 lr-h-10 lr-opacity-40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg>{%- endif -%}</div>{%- endif -%}</div>
    </div>
  </div>
</section>

<!-- DAD -->
<section class="lr-py-16 md:lr-py-24">
  <div class="lr-max-w-6xl lr-mx-auto lr-px-4 lr-grid lr-grid-cols-1 md:lr-grid-cols-2 lr-gap-10 lr-items-center">
    <div class="lr-relative lr-aspect-[4/5] lr-rounded-3xl lr-overflow-hidden">
      <div class="lr-absolute lr-inset-0">{%- if section.settings.dad_image != blank -%}{%- assign img_alt = section.settings.dad_image.alt | default: 'LoftRest cervical traction pillow' -%}{{ section.settings.dad_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 768px) 560px, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', loading: 'lazy', alt: img_alt }}{%- else -%}<div class="lr-w-full lr-h-full lr-flex lr-flex-col lr-items-center lr-justify-center lr-gap-2 lr-p-4 lr-text-center lr-bg-gradient-to-br lr-from-brand-lightBlue lr-to-sky-100 lr-text-brand-royal">{%- if request.design_mode -%}<div class="lr-absolute lr-inset-3 lr-rounded-2xl lr-border-2 lr-border-dashed lr-border-sky-300"></div><svg class="lr-w-8 lr-h-8" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 5h6" /><path d="M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg><span class="lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">Add image: Photo of Dad (or his workday)</span>{%- else -%}<svg class="lr-w-10 lr-h-10 lr-opacity-40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg>{%- endif -%}</div>{%- endif -%}</div>
    </div>
    <div>
      <p class="lr-text-brand-royal lr-font-bold lr-text-sm lr-uppercase lr-tracking-wide">{{ s.dad_label | escape }}</p>
      <h2 class="lr-mt-2 lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight">{{ s.dad_heading | escape }}</h2>
      <p class="lr-mt-5 lr-text-lg lr-text-slate-700 lr-leading-relaxed lr-whitespace-pre-line">{{ s.dad_text | escape }}</p>
    </div>
  </div>
</section>

<!-- MUM -->
<section class="lr-py-16 md:lr-py-24 lr-bg-white lr-border-y lr-border-slate-200">
  <div class="lr-max-w-6xl lr-mx-auto lr-px-4 lr-grid lr-grid-cols-1 md:lr-grid-cols-2 lr-gap-10 lr-items-center">
    <div class="md:lr-order-2 lr-relative lr-aspect-[4/5] lr-rounded-3xl lr-overflow-hidden">
      <div class="lr-absolute lr-inset-0">{%- if section.settings.mum_image != blank -%}{%- assign img_alt = section.settings.mum_image.alt | default: 'LoftRest cervical traction pillow' -%}{{ section.settings.mum_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 768px) 560px, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', loading: 'lazy', alt: img_alt }}{%- else -%}<div class="lr-w-full lr-h-full lr-flex lr-flex-col lr-items-center lr-justify-center lr-gap-2 lr-p-4 lr-text-center lr-bg-gradient-to-br lr-from-brand-lightBlue lr-to-sky-100 lr-text-brand-royal">{%- if request.design_mode -%}<div class="lr-absolute lr-inset-3 lr-rounded-2xl lr-border-2 lr-border-dashed lr-border-sky-300"></div><svg class="lr-w-8 lr-h-8" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 5h6" /><path d="M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg><span class="lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">Add image: Photo of Mum (or her evenings)</span>{%- else -%}<svg class="lr-w-10 lr-h-10 lr-opacity-40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg>{%- endif -%}</div>{%- endif -%}</div>
    </div>
    <div class="md:lr-order-1">
