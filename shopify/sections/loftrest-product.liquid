            <span class="lr-flex-1">
              <span class="lr-block lr-font-bold lr-text-brand-navy">{{ block.settings.label | escape }}</span>
              {%- if block.settings.note != blank -%}<span class="lr-block lr-text-sm lr-text-slate-500">{{ block.settings.note | escape }}</span>{%- endif -%}
            </span>
            <span class="lr-text-right">
              {%- if use_discount -%}
              <span class="lr-block lr-font-extrabold lr-text-brand-navy">{{ bundle_final | money }}</span>
              <span class="lr-block lr-text-xs lr-text-slate-400 lr-line-through">{{ bundle_price | money }}</span>
              {%- else -%}
              <span class="lr-block lr-font-extrabold lr-text-brand-navy">{{ bundle_price | money }}</span>
              {%- endif -%}
            </span>
            {%- if block.settings.badge != blank -%}<span class="lr-text-xs lr-font-bold lr-bg-brand-emerald lr-text-white lr-px-2 lr-py-1 lr-rounded">{{ block.settings.badge | escape }}</span>{%- endif -%}
          </label>
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" id="lr-qty" value="{{ offers.first.settings.quantity | default: 1 }}">
        {%- else -%}
        <input type="hidden" name="quantity" id="lr-qty" value="1">
        {%- endif -%}

        <button type="submit" id="lr-add" {% unless variant.available %}disabled{% endunless %} class="lr-mt-5 lr-w-full lr-bg-brand-blue hover:lr-bg-sky-600 disabled:lr-opacity-50 lr-text-white lr-font-extrabold lr-text-lg lr-px-8 lr-py-4 lr-rounded-xl lr-shadow-lg lr-transition-colors">
          {%- if variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
        <div class="lr-mt-3">{{ form | payment_button }}</div>
      {%- endform -%}

      <!-- Trust row: only facts that are true for this store -->
      <ul class="lr-mt-6 lr-grid lr-grid-cols-1 sm:lr-grid-cols-2 lr-gap-3 lr-text-sm lr-text-slate-700">
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> Secure checkout by Shopify</li>
        {%- if section.settings.shipping_note != blank -%}
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg> {{ section.settings.shipping_note | escape }}</li>
        {%- endif -%}
        {%- if section.settings.show_trial -%}
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg> {{ section.settings.trial_days }}-night trial</li>
        {%- endif -%}
        {%- if shop.refund_policy.url != blank -%}
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" /></svg> <a href="{{ shop.refund_policy.url }}" class="lr-underline">{{ section.settings.returns_label | default: 'Returns and refunds' | escape }}</a></li>
        {%- endif -%}
      </ul>
      {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="lr-mt-4 lr-flex lr-flex-wrap lr-gap-2" aria-label="Accepted payment methods">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'lr-h-6 lr-w-auto' }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="lr-mt-12 lr-bg-brand-navy lr-text-white">
    <div class="lr-max-w-6xl lr-mx-auto lr-px-4 lr-py-6 lr-grid lr-grid-cols-2 md:lr-grid-cols-4 lr-gap-4 lr-text-sm">
      <div class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M10 2h4" /><path d="M4.6 11a8 8 0 0 0 1.7 8.7 8 8 0 0 0 8.7 1.7" /><path d="M7.4 7.4a8 8 0 0 1 10.3 1 8 8 0 0 1 .9 10.2" /><path d="m2 2 20 20" /><path d="M12 12v-2" /></svg> Automatic shut-off timer</div>
      <div class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><circle cx="10" cy="7" r="1" /><circle cx="4" cy="20" r="1" /><path d="M4.7 19.3 19 5" /><path d="m21 3-3 1 2 2Z" /><path d="M9.26 7.68 5 12l2 5" /><path d="m10 14 5 2 3.5-3.5" /><path d="m18 12 1-1 1 1-1 1Z" /></svg> Low-voltage 5V USB power</div>
      <div class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" /><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" /><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" /></svg> High-density memory foam</div>
      <div class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-6 lr-h-6 lr-shrink-0 lr-text-sky-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> Secure Shopify checkout</div>
    </div>
  </section>

  <!-- DOES IT WORK? (honest explainer) -->
  <section class="lr-max-w-4xl lr-mx-auto lr-px-4 lr-py-16">
    <p class="lr-text-brand-blue lr-font-bold lr-text-sm lr-uppercase lr-tracking-wide">How it works</p>
    <h2 class="lr-mt-2 lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight">What is a cervical traction pillow?</h2>
    <div class="lr-mt-6 lr-space-y-4 lr-text-lg lr-text-slate-700 lr-leading-relaxed">
      <p>A cervical traction pillow uses air chambers to give your neck a gentle, lengthening stretch while you lie back. Warmth and massage are two of the most popular ways people unwind at home.</p>
      <p>LoftRest™ puts all three into one device for a 15&ndash;30 minute relaxation session, then works as a contoured memory foam pillow you sleep on all night.</p>
      <p class="lr-text-base lr-text-slate-500">LoftRest™ is a comfort and relaxation product. It is not a medical device and is not designed to diagnose, treat or relieve any medical condition. If you have neck pain, see a health professional.</p>
    </div>
  </section>

  <!-- BEDTIME RESET -->
  <section id="reset" class="lr-py-16 md:lr-py-20 lr-bg-white lr-border-t lr-border-slate-200 lr-scroll-mt-16">
    <div class="lr-max-w-6xl lr-mx-auto lr-px-4 lr-grid lr-grid-cols-1 lg:lr-grid-cols-2 lr-gap-10 lr-items-center">
      <div>
        <p class="lr-text-brand-blue lr-font-bold lr-text-sm lr-uppercase lr-tracking-wide">Stress &amp; sleep</p>
        <h2 class="lr-mt-2 lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight">Why stress keeps you awake at night</h2>
        <p class="lr-mt-5 lr-text-lg lr-text-slate-700 lr-leading-relaxed">After a stressful day, it&rsquo;s common to carry that tension in your neck, shoulders and the base of your skull. When your body still feels wound up at bedtime, it&rsquo;s hard to get comfortable and switch off.</p>
        <p class="lr-mt-4 lr-text-lg lr-text-slate-700 lr-leading-relaxed">That&rsquo;s why a simple wind-down routine helps: giving yourself a few minutes to relax before you try to sleep.</p>
      </div>
      <div class="lr-rounded-3xl lr-bg-brand-navy lr-text-white lr-p-6 md:lr-p-8">
        <p class="lr-text-sky-400 lr-font-bold lr-text-sm lr-uppercase lr-tracking-wide">Your wind-down</p>
        <h3 class="lr-mt-2 lr-text-2xl md:lr-text-3xl lr-font-extrabold">The 15-Minute LoftRest™ Bedtime Reset</h3>
        <ol class="lr-mt-6 lr-space-y-4">
          <li class="lr-flex lr-gap-4"><span class="lr-w-10 lr-h-10 lr-shrink-0 lr-rounded-xl lr-bg-sky-500/15 lr-text-sky-400 lr-flex lr-items-center lr-justify-center"><svg class="lr-w-5 lr-h-5" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12.8 19.6A2 2 0 1 0 14 16H2" /><path d="M17.5 8a2.5 2.5 0 1 1 2 4H2" /><path d="M9.8 4.4A2 2 0 1 1 11 8H2" /></svg></span><span><strong class="lr-block">Gentle air traction</strong><span class="lr-text-slate-300">A soft, lengthening stretch for your neck.</span></span></li>
          <li class="lr-flex lr-gap-4"><span class="lr-w-10 lr-h-10 lr-shrink-0 lr-rounded-xl lr-bg-orange-500/15 lr-text-orange-400 lr-flex lr-items-center lr-justify-center"><svg class="lr-w-5 lr-h-5" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4" /></svg></span><span><strong class="lr-block">Soothing warmth</strong><span class="lr-text-slate-300">Constant, even heat around the base of your neck.</span></span></li>
          <li class="lr-flex lr-gap-4"><span class="lr-w-10 lr-h-10 lr-shrink-0 lr-rounded-xl lr-bg-emerald-500/15 lr-text-emerald-400 lr-flex lr-items-center lr-justify-center"><svg class="lr-w-5 lr-h-5" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" /></svg></span><span><strong class="lr-block">Light micro-pulse massage</strong><span class="lr-text-slate-300">Gentle pulses to help you unwind.</span></span></li>
        </ol>
        <p class="lr-mt-6 lr-text-slate-300 lr-leading-relaxed">Lie back, breathe and let the day go. When the timer switches everything off, you&rsquo;re already where you need to be: resting on contoured memory foam, ready to drift off.</p>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="lr-bg-white lr-border-y lr-border-slate-200">
    <div class="lr-max-w-5xl lr-mx-auto lr-px-4 lr-py-16">
      <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight lr-text-center">How LoftRest™ compares</h2>
      <div class="lr-mt-8 lr-overflow-x-auto">
        <table class="lr-w-full lr-min-w-[560px] lr-text-left lr-text-sm md:lr-text-base">
          <thead>
            <tr class="lr-border-b lr-border-slate-200">
              <th class="lr-py-3 lr-pr-4 lr-font-semibold lr-text-slate-500">Feature</th>
              <th class="lr-py-3 lr-px-3 lr-font-extrabold lr-text-brand-blue">LoftRest™</th>
              <th class="lr-py-3 lr-px-3 lr-font-semibold lr-text-slate-600">Memory foam pillow</th>
              <th class="lr-py-3 lr-px-3 lr-font-semibold lr-text-slate-600">Foam neck stretcher</th>
              <th class="lr-py-3 lr-pl-3 lr-font-semibold lr-text-slate-600">Heat pack</th>
            </tr>
