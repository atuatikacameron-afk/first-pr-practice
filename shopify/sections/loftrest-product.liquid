  <!-- SPECS + SAFETY -->
  <section class="lr-max-w-5xl lr-mx-auto lr-px-4 lr-py-16 lr-grid lr-grid-cols-1 md:lr-grid-cols-2 lr-gap-8">
    <div class="lr-rounded-2xl lr-bg-white lr-border lr-border-slate-200 lr-p-6">
      <h2 class="lr-text-2xl lr-font-extrabold lr-text-brand-navy">Specifications</h2>
      <dl class="lr-mt-5 lr-space-y-4 lr-text-slate-700">
        <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z" /><path d="m14.5 12.5 2-2" /><path d="m11.5 9.5 2-2" /><path d="m8.5 6.5 2-2" /><path d="m17.5 15.5 2-2" /></svg><div><dt class="lr-font-semibold lr-text-brand-navy">Size</dt><dd>42.5 &times; 27 cm (16.7 &times; 10.6 in)</dd></div></div>
        <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" /><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" /><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" /></svg><div><dt class="lr-font-semibold lr-text-brand-navy">Pillow</dt><dd>High-density contoured memory foam</dd></div></div>
        <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /></svg><div><dt class="lr-font-semibold lr-text-brand-navy">Cover</dt><dd>Soft, breathable flannel</dd></div></div>
        <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><circle cx="10" cy="7" r="1" /><circle cx="4" cy="20" r="1" /><path d="M4.7 19.3 19 5" /><path d="m21 3-3 1 2 2Z" /><path d="M9.26 7.68 5 12l2 5" /><path d="m10 14 5 2 3.5-3.5" /><path d="m18 12 1-1 1 1-1 1Z" /></svg><div><dt class="lr-font-semibold lr-text-brand-navy">Power</dt><dd>5V USB. Works with a USB wall adapter, laptop or power bank.</dd></div></div>
        <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M10 2h4" /><path d="M4.6 11a8 8 0 0 0 1.7 8.7 8 8 0 0 0 8.7 1.7" /><path d="M7.4 7.4a8 8 0 0 1 10.3 1 8 8 0 0 1 .9 10.2" /><path d="m2 2 20 20" /><path d="M12 12v-2" /></svg><div><dt class="lr-font-semibold lr-text-brand-navy">Safety</dt><dd>Built-in automatic shut-off timer</dd></div></div>
        <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z" /></svg><div><dt class="lr-font-semibold lr-text-brand-navy">Modes</dt><dd>Air traction, constant-temperature heat, micro-kinetic massage</dd></div></div>
      </dl>
    </div>
    <div class="lr-rounded-2xl lr-bg-amber-50 lr-border lr-border-amber-200 lr-p-6">
      <h2 class="lr-flex lr-items-center lr-gap-2 lr-text-2xl lr-font-extrabold lr-text-brand-navy"><svg class="lr-w-6 lr-h-6 lr-text-amber-500" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg> Safe use</h2>
      <ul class="lr-mt-5 lr-space-y-3 lr-text-slate-700">
        <li>Start on the gentlest setting and build up gradually.</li>
        <li>Stop if you feel sharp pain, numbness, tingling or dizziness.</li>
        <li>Talk to your doctor first if you are pregnant, have had neck or spine surgery, or have osteoporosis, a recent neck injury, rheumatoid arthritis, a spinal condition or a circulation disorder.</li>
        <li>LoftRest™ is a comfort and relaxation product, not a medical device.</li>
      </ul>
    </div>
  </section>

  <!-- REVIEWS: genuine reviews only (review blocks or a review app block) -->
  {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
  {%- if review_count > 0 or app_blocks.size > 0 -%}
  <section id="reviews" class="lr-bg-white lr-border-t lr-border-slate-200 lr-scroll-mt-16">
    <div class="lr-max-w-6xl lr-mx-auto lr-px-4 lr-py-16">
      <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight lr-text-center">Customer reviews</h2>
      {%- if review_count > 0 -%}
      <p class="lr-mt-3 lr-text-center lr-text-slate-600"><strong class="lr-text-brand-navy">{{ rating }} out of 5</strong> from {{ review_count }} review{% if review_count != 1 %}s{% endif %}</p>
      <div class="lr-mt-10 lr-grid lr-grid-cols-1 sm:lr-grid-cols-2 lg:lr-grid-cols-3 lr-gap-6">
        {%- for block in reviews -%}
        <figure class="lr-rounded-2xl lr-border lr-border-slate-200 lr-p-6 lr-flex lr-flex-col" {{ block.shopify_attributes }}>
          <div class="lr-flex lr-text-amber-400" aria-label="{{ block.settings.stars }} out of 5 stars">{%- for i in (1..block.settings.stars) -%}<svg class="lr-w-4 lr-h-4 lr-fill-current" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>{%- endfor -%}</div>
          {%- if block.settings.title != blank -%}<h3 class="lr-mt-3 lr-font-bold lr-text-brand-navy">{{ block.settings.title | escape }}</h3>{%- endif -%}
          <blockquote class="lr-mt-2 lr-text-slate-600 lr-flex-1">{{ block.settings.review | escape }}</blockquote>
          <figcaption class="lr-mt-4 lr-text-sm lr-font-semibold lr-text-slate-800">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="lr-inline-flex lr-items-center lr-gap-1 lr-font-normal lr-text-brand-emerald"><svg class="lr-w-4 lr-h-4" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" /><path d="m16 9-5.5 5.5L8 12" /></svg> Verified buyer</span>{% endif %}</figcaption>
        </figure>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- for block in app_blocks -%}<div class="lr-mt-10">{% render block %}</div>{%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  <!-- FAQ -->
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <section class="lr-max-w-3xl lr-mx-auto lr-px-4 lr-py-16">
    <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight lr-text-center">Questions before you buy</h2>
    <div class="lr-mt-10 lr-space-y-3">
      {%- for block in faqs -%}
      <details class="lr-group lr-rounded-xl lr-border lr-border-slate-200 lr-bg-white lr-p-5" {{ block.shopify_attributes }}>
        <summary class="lr-flex lr-items-center lr-justify-between lr-gap-4 lr-cursor-pointer lr-font-bold lr-text-brand-navy lr-list-none">
          <h3>{{ block.settings.question | escape }}</h3>
          <svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-transition-transform group-open:lr-rotate-180" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <p class="lr-mt-3 lr-text-slate-600 lr-leading-relaxed">{{ block.settings.answer | escape }}</p>
      </details>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  <!-- POLICIES & CONTACT -->
  <section class="lr-bg-white lr-border-t lr-border-slate-200">
    <div class="lr-max-w-5xl lr-mx-auto lr-px-4 lr-py-12 lr-grid lr-grid-cols-1 md:lr-grid-cols-3 lr-gap-6 lr-text-sm lr-text-slate-700">
      <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg><div><p class="lr-font-bold lr-text-brand-navy">Questions?</p>{%- if support_email != blank -%}<p class="lr-mt-1">Email us at <a href="mailto:{{ support_email }}" class="lr-underline">{{ support_email }}</a></p>{%- endif -%}</div></div>
      <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg><div><p class="lr-font-bold lr-text-brand-navy">Shipping</p><p class="lr-mt-1">{%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}" class="lr-underline">Read our shipping policy</a>{%- else -%}{{ section.settings.shipping_note | default: 'Shipping options are shown at checkout.' | escape }}{%- endif -%}</p></div></div>
      <div class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" /></svg><div><p class="lr-font-bold lr-text-brand-navy">Returns</p><p class="lr-mt-1">{%- if shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}" class="lr-underline">Read our refund policy</a>{%- else -%}Contact us about returns.{%- endif -%}</p></div></div>
    </div>
  </section>

  <!-- STICKY ADD TO CART (mobile) -->
  <div class="md:lr-hidden lr-fixed lr-inset-x-0 lr-bottom-0 lr-z-40 lr-border-t lr-border-slate-200 lr-bg-white/95 lr-backdrop-blur-md">
    <div class="lr-px-4 lr-py-3 lr-flex lr-items-center lr-justify-between lr-gap-3">
      <div class="lr-min-w-0">
        <p class="lr-font-bold lr-text-brand-navy lr-truncate lr-text-sm">{{ product.title | escape }}</p>
        <p class="lr-text-sm"><span class="lr-font-extrabold lr-text-brand-navy">{{ variant.price | money }}</span>{%- if on_sale -%} <span class="lr-text-slate-400 lr-line-through">{{ variant.compare_at_price | money }}</span>{%- endif -%}</p>
      </div>
      <button type="submit" form="lr-product-form" {% unless variant.available %}disabled{% endunless %} class="lr-shrink-0 lr-bg-brand-blue hover:lr-bg-sky-600 disabled:lr-opacity-50 lr-text-white lr-font-extrabold lr-px-5 lr-py-3 lr-rounded-xl lr-shadow-lg">Add to cart</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('loftrest-{{ section.id }}');
    if (!root) return;
    // Gallery thumbnails
    var main = root.querySelector('#lr-main-image');
    root.querySelectorAll('[data-lr-thumb]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!main) return;
        main.removeAttribute('srcset');
        main.src = btn.dataset.lrThumb;
        main.alt = btn.dataset.lrAlt || '';
      });
    });
    // Offers: set quantity and apply the matching discount code at checkout
    var qty = root.querySelector('#lr-qty');
    var returnTo = root.querySelector('#lr-return-to');
    var base = returnTo ? returnTo.value : '/checkout';
    function applyOffer(input) {
      if (!input || !qty) return;
      qty.value = input.value;
      if (returnTo) returnTo.value = input.dataset.code ? '/discount/' + encodeURIComponent(input.dataset.code) + '?redirect=' + encodeURIComponent(base) : base;
    }
    root.querySelectorAll('input[name="lr-offer"]').forEach(function (input) {
      input.addEventListener('change', function () { applyOffer(input); });
    });
    applyOffer(root.querySelector('input[name="lr-offer"]:checked'));
  })();
</script>

<script type="application/ld+json">{{ product | structured_data }}</script>
{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faqs -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
</div>

