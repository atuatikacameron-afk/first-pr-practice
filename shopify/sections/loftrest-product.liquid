        <li class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" /></svg> Micro-kinetic massage modes</li>
        <li class="lr-flex lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-navy" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" /></svg> Memory foam pillow for all-night support</li>
      </ul>

      {%- form 'product', product, id: 'lr-product-form', class: 'lr-mt-6' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="return_to" id="lr-return-to" value="{% if section.settings.go_to_checkout %}/checkout{% else %}{{ routes.cart_url }}{% endif %}">

        {%- if offers.size > 0 -%}
        <fieldset class="lr-space-y-3">
          <legend class="lr-font-bold lr-text-brand-navy lr-mb-3">Choose your offer</legend>
          {%- for block in offers -%}
            {%- assign qty = block.settings.quantity -%}
            {%- assign bundle_price = variant.price | times: qty -%}
            {%- assign use_discount = false -%}
            {%- if block.settings.discount_percent > 0 and block.settings.discount_code != blank -%}{%- assign use_discount = true -%}{%- endif -%}
            {%- if use_discount -%}
              {%- assign off = bundle_price | times: block.settings.discount_percent | divided_by: 100 -%}
              {%- assign bundle_final = bundle_price | minus: off -%}
            {%- endif -%}
          <label class="lr-flex lr-items-center lr-gap-4 lr-rounded-xl lr-border-2 lr-border-slate-200 lr-p-4 lr-cursor-pointer has-[:checked]:lr-border-brand-blue has-[:checked]:lr-bg-brand-lightBlue/40" {{ block.shopify_attributes }}>
