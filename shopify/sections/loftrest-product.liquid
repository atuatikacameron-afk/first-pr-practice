<div class="loftrest" id="loftrest-{{ section.id }}">
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if variant.compare_at_price > variant.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign reviews = section.blocks | where: 'type', 'review' -%}
{%- assign review_count = reviews | size -%}
{%- assign star_total = 0 -%}
{%- for r in reviews -%}{%- assign star_total = star_total | plus: r.settings.stars -%}{%- endfor -%}
{%- if review_count > 0 -%}{%- assign rating = star_total | times: 1.0 | divided_by: review_count | round: 1 -%}{%- endif -%}
{%- assign offers = section.blocks | where: 'type', 'offer' -%}
{%- assign support_email = section.settings.support_email | default: shop.email -%}

<div class="lr-pb-24 md:lr-pb-0">

  <!-- ABOVE THE FOLD: gallery + buy box -->
  <section class="lr-max-w-6xl lr-mx-auto lr-px-4 lr-pt-6 md:lr-pt-10 lr-grid lr-grid-cols-1 md:lr-grid-cols-2 lr-gap-8 md:lr-gap-12">

    <!-- Gallery -->
    <div>
      <div class="lr-relative lr-aspect-square lr-rounded-2xl lr-overflow-hidden lr-bg-white lr-border lr-border-slate-200">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 768px) 50vw, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', id: 'lr-main-image', loading: 'eager', fetchpriority: 'high' }}
        {%- endif -%}
        {%- if on_sale -%}
        <span class="lr-absolute lr-top-4 lr-left-4 lr-bg-brand-heat lr-text-white lr-text-xs lr-font-bold lr-px-2.5 lr-py-1 lr-rounded-full">SAVE {{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}%</span>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
      <div class="lr-mt-3 lr-grid lr-grid-cols-5 lr-gap-2">
        {%- for media in product.media limit: 10 -%}
          {%- if media.media_type == 'image' -%}
          <button type="button" data-lr-thumb="{{ media | image_url: width: 1400 }}" data-lr-alt="{{ media.alt | escape }}" aria-label="Show image {{ forloop.index }}" class="lr-aspect-square lr-rounded-lg lr-overflow-hidden lr-border lr-border-slate-200 hover:lr-border-brand-blue">
            {{ media | image_url: width: 200 | image_tag: class: 'lr-w-full lr-h-full lr-object-cover', loading: 'lazy' }}
          </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>

    <!-- Buy box -->
    <div>
      <p class="lr-text-brand-blue lr-font-bold lr-text-xs lr-uppercase lr-tracking-wide">{{ product.vendor | escape }}</p>
      <h1 class="lr-mt-2 lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight">{{ product.title | escape }}</h1>

      {%- if review_count > 0 -%}
      <a href="#reviews" class="lr-mt-3 lr-inline-flex lr-items-center lr-gap-2 lr-text-sm lr-text-slate-600">
        {%- assign rating_rounded = rating | round -%}
