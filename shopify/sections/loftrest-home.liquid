{%- assign faqs = section.blocks | where: 'type', 'faq' -%}
{%- assign bundle_ok = false -%}
{%- if section.settings.bundle_code != blank and section.settings.bundle_percent > 0 -%}{%- assign bundle_ok = true -%}{%- endif -%}

<style>
  @keyframes lr-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .loftrest .lr-marquee { animation: lr-marquee 40s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .loftrest .lr-marquee { animation: none; } }
</style>

<!-- HERO -->
<section class="lr-relative lr-overflow-hidden lr-bg-gradient-to-br lr-from-brand-indigo lr-via-brand-royal lr-to-brand-blue lr-text-white">
  <div class="lr-max-w-7xl lr-mx-auto lr-grid lr-grid-cols-1 lg:lr-grid-cols-2 lr-items-stretch">
    <div class="lr-px-4 lr-py-12 md:lr-py-20 lg:lr-pr-12 lr-flex lr-flex-col lr-justify-center lr-order-2 lg:lr-order-1">
      {%- if section.settings.hero_badge != blank -%}<span class="lr-self-start lr-rounded-md lr-border lr-border-white/40 lr-px-3 lr-py-1 lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">{{ section.settings.hero_badge | escape }}</span>{%- endif -%}
      <h1 class="lr-mt-4 lr-text-4xl md:lr-text-5xl lr-font-extrabold lr-tracking-tight lr-leading-tight">{{ section.settings.hero_heading | escape }}</h1>
      <p class="lr-mt-4 lr-text-lg lr-text-sky-100 lr-max-w-xl">{{ section.settings.hero_text | escape }}</p>
      <ul class="lr-mt-6 lr-flex lr-flex-wrap lr-gap-x-6 lr-gap-y-2 lr-text-sm lr-font-semibold">
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-sky-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 6 9 17l-5-5" /></svg> Gentle air traction</li>
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-sky-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 6 9 17l-5-5" /></svg> Soothing warmth</li>
        <li class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-sky-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 6 9 17l-5-5" /></svg> All-night memory foam</li>
      </ul>
      <a href="#offers" class="lr-mt-8 lr-self-start lr-inline-flex lr-items-center lr-gap-2 lr-bg-white lr-text-brand-royal hover:lr-bg-sky-50 lr-font-extrabold lr-px-8 lr-py-4 lr-rounded-full lr-shadow-lg lr-transition-colors">Shop LoftRest™ <svg class="lr-w-5 lr-h-5" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
    </div>
    <div class="lr-relative lr-min-h-[320px] lg:lr-min-h-[560px] lr-order-1 lg:lr-order-2">
      <div class="lr-absolute lr-inset-0">{%- if section.settings.hero_image != blank -%}{%- assign img_alt = section.settings.hero_image.alt | default: 'LoftRest cervical traction pillow' -%}{{ section.settings.hero_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 1024px) 50vw, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', loading: 'eager', fetchpriority: 'high', alt: img_alt }}{%- else -%}<div class="lr-w-full lr-h-full lr-flex lr-flex-col lr-items-center lr-justify-center lr-gap-2 lr-p-4 lr-text-center lr-bg-gradient-to-br lr-from-brand-lightBlue lr-to-sky-100 lr-text-brand-royal">{%- if request.design_mode -%}<div class="lr-absolute lr-inset-3 lr-rounded-2xl lr-border-2 lr-border-dashed lr-border-sky-300"></div><svg class="lr-w-8 lr-h-8" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 5h6" /><path d="M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg><span class="lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">Add image: Hero photo (person relaxing on LoftRest)</span>{%- else -%}<svg class="lr-w-10 lr-h-10 lr-opacity-40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg>{%- endif -%}</div>{%- endif -%}</div>
    </div>
  </div>
  <div class="lr-bg-brand-indigo/60 lr-border-t lr-border-white/10">
    <ul class="lr-max-w-7xl lr-mx-auto lr-px-4 lr-py-5 lr-grid lr-grid-cols-1 sm:lr-grid-cols-3 lr-gap-4 lr-text-sm">
      <li class="lr-flex lr-items-center lr-justify-center lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-text-sky-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12.8 19.6A2 2 0 1 0 14 16H2" /><path d="M17.5 8a2.5 2.5 0 1 1 2 4H2" /><path d="M9.8 4.4A2 2 0 1 1 11 8H2" /></svg> A relaxing 15&ndash;30 minute wind-down</li>
      <li class="lr-flex lr-items-center lr-justify-center lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-text-sky-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" /></svg> Then contoured support all night</li>
      <li class="lr-flex lr-items-center lr-justify-center lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-text-sky-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M10 2h4" /><path d="M4.6 11a8 8 0 0 0 1.7 8.7 8 8 0 0 0 8.7 1.7" /><path d="M7.4 7.4a8 8 0 0 1 10.3 1 8 8 0 0 1 .9 10.2" /><path d="m2 2 20 20" /><path d="M12 12v-2" /></svg> Automatic shut-off timer</li>
    </ul>
  </div>
</section>

<!-- INTRO: product + feature tiles -->
<section class="lr-py-16 md:lr-py-24">
  <div class="lr-max-w-5xl lr-mx-auto lr-px-4 lr-text-center">
    <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight">Your evening wind-down, reinvented</h2>
    <p class="lr-mt-4 lr-text-lg lr-text-slate-600 lr-max-w-2xl lr-mx-auto">You spend a third of your life on your pillow. LoftRest™ turns bedtime into a moment to relax: a short session to unwind, then a pillow that supports your neck until morning.</p>
    <div class="lr-mt-10 lr-relative lr-aspect-[16/9] lr-rounded-3xl lr-overflow-hidden">
      <div class="lr-absolute lr-inset-0">{%- if section.settings.product_image != blank -%}{%- assign img_alt = section.settings.product_image.alt | default: 'LoftRest cervical traction pillow' -%}{{ section.settings.product_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 1024px) 960px, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', loading: 'lazy', alt: img_alt }}{%- else -%}<div class="lr-w-full lr-h-full lr-flex lr-flex-col lr-items-center lr-justify-center lr-gap-2 lr-p-4 lr-text-center lr-bg-gradient-to-br lr-from-brand-lightBlue lr-to-sky-100 lr-text-brand-royal">{%- if request.design_mode -%}<div class="lr-absolute lr-inset-3 lr-rounded-2xl lr-border-2 lr-border-dashed lr-border-sky-300"></div><svg class="lr-w-8 lr-h-8" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 5h6" /><path d="M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg><span class="lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">Add image: Product photo (LoftRest on its own)</span>{%- else -%}<svg class="lr-w-10 lr-h-10 lr-opacity-40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg>{%- endif -%}</div>{%- endif -%}</div>
    </div>
    <ul class="lr-mt-8 lr-grid lr-grid-cols-2 md:lr-grid-cols-4 lr-gap-4">
      <li class="lr-rounded-2xl lr-bg-white lr-border lr-border-slate-200 lr-p-5"><svg class="lr-w-7 lr-h-7 lr-mx-auto lr-text-brand-royal" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12.8 19.6A2 2 0 1 0 14 16H2" /><path d="M17.5 8a2.5 2.5 0 1 1 2 4H2" /><path d="M9.8 4.4A2 2 0 1 1 11 8H2" /></svg><p class="lr-mt-3 lr-font-bold lr-text-brand-navy lr-text-sm">Gentle air traction</p></li>
      <li class="lr-rounded-2xl lr-bg-white lr-border lr-border-slate-200 lr-p-5"><svg class="lr-w-7 lr-h-7 lr-mx-auto lr-text-brand-heat" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4" /></svg><p class="lr-mt-3 lr-font-bold lr-text-brand-navy lr-text-sm">Soothing warmth</p></li>
      <li class="lr-rounded-2xl lr-bg-white lr-border lr-border-slate-200 lr-p-5"><svg class="lr-w-7 lr-h-7 lr-mx-auto lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" /></svg><p class="lr-mt-3 lr-font-bold lr-text-brand-navy lr-text-sm">Micro-pulse massage</p></li>
      <li class="lr-rounded-2xl lr-bg-white lr-border lr-border-slate-200 lr-p-5"><svg class="lr-w-7 lr-h-7 lr-mx-auto lr-text-brand-royal" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" /><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" /><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" /></svg><p class="lr-mt-3 lr-font-bold lr-text-brand-navy lr-text-sm">All-night memory foam</p></li>
    </ul>
    <a href="#offers" class="lr-mt-10 lr-inline-flex lr-items-center lr-gap-2 lr-bg-brand-royal hover:lr-bg-brand-indigo lr-text-white lr-font-extrabold lr-px-8 lr-py-4 lr-rounded-full lr-shadow-lg lr-transition-colors">Shop LoftRest™ <svg class="lr-w-5 lr-h-5" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
  </div>
</section>

<!-- OFFERS -->
<section id="offers" class="lr-py-16 md:lr-py-24 lr-bg-brand-lightBlue/50 lr-scroll-mt-16">
  <div class="lr-max-w-5xl lr-mx-auto lr-px-4">
    <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight lr-text-center">Choose your LoftRest™</h2>
    <p class="lr-mt-3 lr-text-center lr-text-slate-600">Free standard shipping in Australia &middot; 30-day returns &middot; Secure checkout</p>
    <div class="lr-mt-10 lr-grid lr-grid-cols-1 md:lr-grid-cols-2 lr-gap-6">
      <!-- Offer 1 -->
      <div class="lr-rounded-3xl lr-bg-white lr-border lr-border-slate-200 lr-p-6 lr-flex lr-flex-col">
        <div class="lr-relative lr-aspect-[4/3] lr-rounded-2xl lr-overflow-hidden">
          <div class="lr-absolute lr-inset-0">{%- if section.settings.offer1_image != blank -%}{%- assign img_alt = section.settings.offer1_image.alt | default: 'LoftRest cervical traction pillow' -%}{{ section.settings.offer1_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 768px) 460px, 100vw', class: 'lr-w-full lr-h-full lr-object-cover', loading: 'lazy', alt: img_alt }}{%- else -%}<div class="lr-w-full lr-h-full lr-flex lr-flex-col lr-items-center lr-justify-center lr-gap-2 lr-p-4 lr-text-center lr-bg-gradient-to-br lr-from-brand-lightBlue lr-to-sky-100 lr-text-brand-royal">{%- if request.design_mode -%}<div class="lr-absolute lr-inset-3 lr-rounded-2xl lr-border-2 lr-border-dashed lr-border-sky-300"></div><svg class="lr-w-8 lr-h-8" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 5h6" /><path d="M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg><span class="lr-text-xs lr-font-bold lr-uppercase lr-tracking-wide">Add image: Offer photo (1 pillow)</span>{%- else -%}<svg class="lr-w-10 lr-h-10 lr-opacity-40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0" /><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0" /></svg>{%- endif -%}</div>{%- endif -%}</div>
        </div>
        <h3 class="lr-mt-5 lr-text-xl lr-font-extrabold lr-text-brand-navy">1 &times; LoftRest™</h3>
        <ul class="lr-mt-3 lr-space-y-2 lr-text-sm lr-text-slate-700 lr-flex-1">
          <li class="lr-flex lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-shrink-0 lr-mt-0.5 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 6 9 17l-5-5" /></svg> Air traction, heat &amp; massage</li>
          <li class="lr-flex lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-shrink-0 lr-mt-0.5 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 6 9 17l-5-5" /></svg> Contoured memory foam for all-night support</li>
          <li class="lr-flex lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-shrink-0 lr-mt-0.5 lr-text-brand-emerald" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M20 6 9 17l-5-5" /></svg> USB powered with auto shut-off</li>
        </ul>
        {%- if variant -%}
        <p class="lr-mt-5 lr-text-2xl lr-font-extrabold lr-text-brand-navy">{{ variant.price | money }}</p>
        <form action="{{ routes.cart_add_url }}" method="post" class="lr-mt-4">
          <input type="hidden" name="id" value="{{ variant.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="/checkout">
          <button type="submit" {% unless variant.available %}disabled{% endunless %} class="lr-w-full lr-bg-brand-royal hover:lr-bg-brand-indigo disabled:lr-opacity-50 lr-text-white lr-font-extrabold lr-py-4 lr-rounded-full lr-transition-colors">{% if variant.available %}Buy 1 pillow{% else %}Sold out{% endif %}</button>
        </form>
        {%- endif -%}
      </div>
      <!-- Offer 2 -->
      <div class="lr-relative lr-rounded-3xl lr-bg-gradient-to-b lr-from-brand-lightBlue/60 lr-to-white lr-border-2 lr-border-brand-royal lr-p-6 lr-flex lr-flex-col lr-shadow-xl lr-shadow-brand-royal/15">
        {%- if bundle_ok or section.settings.bundle_badge != blank -%}<span class="lr-absolute -lr-top-4 lr-left-6 lr-z-10 lr-inline-flex lr-items-center lr-gap-1.5 lr-rounded-full lr-bg-gradient-to-r lr-from-brand-emerald lr-to-emerald-500 lr-px-4 lr-py-1.5 lr-text-xs lr-font-extrabold lr-uppercase lr-tracking-wide lr-text-white lr-shadow-md"><svg class="lr-w-4 lr-h-4" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" /><path d="M20 2v4" /><path d="M22 4h-4" /><circle cx="4" cy="20" r="2" /></svg> {% if section.settings.bundle_badge != blank %}{{ section.settings.bundle_badge | escape }}{% else %}Save {{ section.settings.bundle_percent }}%{% endif %}</span>{%- endif -%}
