    {%- for block in reviews -%}
    <figure class="lr-snap-start lr-shrink-0 lr-w-72 md:lr-w-80 lr-rounded-2xl lr-border lr-border-slate-200 lr-bg-white lr-flex lr-flex-col lr-overflow-hidden" {{ block.shopify_attributes }}>
      {%- if block.settings.photo != blank -%}{{ block.settings.photo | image_url: width: 640 | image_tag: widths: '320, 480, 640', sizes: '320px', class: 'lr-w-full lr-aspect-[4/3] lr-object-cover', loading: 'lazy', alt: block.settings.photo.alt }}{%- endif -%}
      <div class="lr-p-5 lr-flex lr-flex-col lr-flex-1">
        {%- if block.settings.stars > 0 -%}<span class="lr-mb-3 lr-flex" aria-label="{{ block.settings.stars }} out of 5 stars">{%- for i in (1..5) -%}{%- if i <= block.settings.stars -%}<svg class="lr-w-4 lr-h-4 lr-fill-current lr-text-amber-400" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>{%- else -%}<svg class="lr-w-4 lr-h-4 lr-text-slate-300" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>{%- endif -%}{%- endfor -%}</span>{%- endif -%}
        <svg class="lr-w-6 lr-h-6 lr-text-brand-royal/30" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z" /><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z" /></svg>
        <blockquote class="lr-mt-2 lr-text-slate-600 lr-flex-1">&ldquo;{{ block.settings.review | escape }}&rdquo;</blockquote>
        <figcaption class="lr-mt-4 lr-text-sm lr-font-semibold lr-text-slate-800">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="lr-inline-flex lr-items-center lr-gap-1 lr-font-normal lr-text-brand-emerald"><svg class="lr-w-4 lr-h-4" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" /><path d="m16 9-5.5 5.5L8 12" /></svg> Verified buyer</span>{% endif %}{% if block.settings.source != blank %}<span class="lr-block lr-mt-0.5 lr-text-xs lr-font-normal lr-text-slate-500">{{ block.settings.source | escape }}</span>{% endif %}</figcaption>
      </div>
    </figure>
    {%- endfor -%}
  </div>
  <p class="lr-mt-6 lr-text-center"><a href="/pages/reviews" class="lr-font-semibold lr-text-brand-royal lr-underline">Read all reviews</a></p>
</section>
{%- endif -%}

<!-- TRUST MARQUEE -->
<div class="lr-overflow-hidden lr-bg-brand-lightBlue lr-border-y lr-border-sky-200 lr-py-4" aria-label="Free standard shipping in Australia, 30-day returns, secure checkout">
  <div class="lr-lr-marquee lr-flex lr-w-max lr-gap-10 lr-text-sm lr-font-semibold lr-text-brand-navy" aria-hidden="true">
    {%- for i in (1..2) -%}
      {%- for j in (1..4) -%}
      <span class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-royal" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg> Free standard shipping in Australia</span>
      <span class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-royal" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" /></svg> 30-day returns</span>
      <span class="lr-flex lr-items-center lr-gap-2"><svg class="lr-w-4 lr-h-4 lr-text-brand-royal" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> Secure checkout</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<!-- FAQ -->
{%- if faqs.size > 0 -%}
<section class="lr-py-16 md:lr-py-24">
  <div class="lr-max-w-3xl lr-mx-auto lr-px-4">
    <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight lr-text-center">Frequently asked questions</h2>
    <div class="lr-mt-10 lr-divide-y lr-divide-slate-200 lr-border-y lr-border-slate-200">
      {%- for block in faqs -%}
      <details class="lr-group lr-py-5" {{ block.shopify_attributes }}>
        <summary class="lr-flex lr-items-center lr-justify-between lr-gap-4 lr-cursor-pointer lr-font-bold lr-text-brand-navy lr-list-none"><h3>{{ block.settings.question | escape }}</h3><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-royal lr-transition-transform group-open:lr-rotate-45" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 12h14" /><path d="M12 5v14" /></svg></summary>
        <p class="lr-mt-3 lr-text-slate-600 lr-leading-relaxed">{{ block.settings.answer | escape }}</p>
      </details>
      {%- endfor -%}
    </div>
    <p class="lr-mt-6 lr-text-center"><a href="/pages/faq" class="lr-font-semibold lr-text-brand-royal lr-underline">See all questions</a></p>
  </div>
</section>
{%- endif -%}

<!-- FINAL CTA -->
<section class="lr-pb-16 md:lr-pb-24">
  <div class="lr-max-w-5xl lr-mx-auto lr-px-4">
    <div class="lr-rounded-3xl lr-bg-gradient-to-br lr-from-brand-indigo lr-via-brand-royal lr-to-brand-blue lr-text-white lr-p-8 md:lr-p-12 lr-text-center">
      <h2 class="lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-tracking-tight">Relax first. Then sleep, supported.</h2>
      {%- if variant -%}<p class="lr-mt-3 lr-text-sky-100">{{ variant.price | money }} &middot; Free standard shipping in Australia &middot; 30-day returns</p>{%- endif -%}
      <a href="#offers" class="lr-mt-8 lr-inline-flex lr-items-center lr-gap-2 lr-bg-white lr-text-brand-royal hover:lr-bg-sky-50 lr-font-extrabold lr-px-8 lr-py-4 lr-rounded-full lr-shadow-lg lr-transition-colors">Shop LoftRest™ <svg class="lr-w-5 lr-h-5" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
    </div>
  </div>
</section>

{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faqs -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
</div>

{% schema %}
{
  "name": "LoftRest homepage",
  "tag": "div",
  "class": "loftrest-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Prices and Buy buttons come from this product."
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Badge",
      "default": "3-in-1 traction pillow"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Your evening wind-down starts here"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Text",
      "default": "Gentle air traction, soothing warmth and massage to help you unwind, then contoured memory foam that supports your neck all night."
    },
    {
      "type": "header",
      "content": "2-pack offer"
    },
    {
      "type": "paragraph",
      "content": "Enter a real discount code from Shopify Discounts and its %. Both must be filled in or no discount is shown."
    },
    {
      "type": "text",
      "id": "bundle_code",
      "label": "Discount code"
    },
    {
      "type": "range",
      "id": "bundle_percent",
      "label": "Discount %",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "bundle_badge",
      "label": "2-pack badge",
      "info": "Leave empty to show \"Save X%\". Only promise what's true (international shipping isn't free)."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero photo (person relaxing on LoftRest)"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product photo (LoftRest on its own)"
    },
    {
      "type": "image_picker",
      "id": "offer1_image",
      "label": "Offer photo (1 pillow)"
    },
    {
      "type": "image_picker",
      "id": "offer2_image",
      "label": "Offer photo (2 pillows)"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image",
      "label": "Lifestyle photo (evening wind-down)"
    },
    {
      "type": "image_picker",
      "id": "moment1_image",
      "label": "In bed"
    },
    {
      "type": "image_picker",
      "id": "moment2_image",
      "label": "On the sofa"
    },
    {
      "type": "image_picker",
      "id": "moment3_image",
      "label": "After work"
    },
    {
      "type": "image_picker",
      "id": "moment4_image",
      "label": "Drifting off"
    },
    {
      "type": "image_picker",
      "id": "features_image",
      "label": "Feature photo (close-up of LoftRest)"
    }
  ],
  "blocks": [
