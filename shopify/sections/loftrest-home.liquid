<!-- REVIEWS (only genuine reviews) -->
{%- if review_count > 0 -%}
<section class="lr-py-16 md:lr-py-20 lr-bg-white">
  <h2 class="lr-px-4 lr-text-3xl md:lr-text-4xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight lr-text-center">What customers say</h2>
