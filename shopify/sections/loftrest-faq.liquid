ext-opacity,1))}.loftrest .lr-text-slate-600{--tw-text-opacity:1;color:rgb(71 85 105/var(--tw-text-opacity,1))}.loftrest .lr-text-slate-700{--tw-text-opacity:1;color:rgb(51 65 85/var(--tw-text-opacity,1))}.loftrest .lr-text-white{--tw-text-opacity:1;color:rgb(255 255 255/var(--tw-text-opacity,1))}.loftrest .lr-underline{text-decoration-line:underline}.loftrest .lr-shadow-lg{--tw-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -4px rgba(0,0,0,.1);--tw-shadow-colored:0 10px 15px -3px var(--tw-shadow-color),0 4px 6px -4px var(--tw-shadow-color);box-shadow:var(--tw-ring-offset-shadow,0 0 #0000),var(--tw-ring-shadow,0 0 #0000),var(--tw-shadow)}.loftrest .lr-transition-colors{transition-property:color,background-color,border-color,text-decoration-color,fill,stroke;transition-timing-function:cubic-bezier(.4,0,.2,1);transition-duration:.15s}.loftrest .lr-transition-transform{transition-property:transform;transition-timing-function:cubic-bezier(.4,0,.2,1);transition-duration:.15s}.loftrest .hover\:lr-bg-sky-600:hover{--tw-bg-opacity:1;background-color:rgb(2 132 199/var(--tw-bg-opacity,1))}.loftrest .hover\:lr-bg-white\/20:hover{background-color:hsla(0,0%,100%,.2)}.loftrest :is(.lr-group[open] .group-open\:lr-rotate-180){--tw-rotate:180deg;transform:translate(var(--tw-translate-x),var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}@media (min-width:768px){.loftrest .md\:lr-grid-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}.loftrest .md\:lr-p-10{padding:2.5rem}.loftrest .md\:lr-py-16{padding-top:4rem;padding-bottom:4rem}.loftrest .md\:lr-text-3xl{font-size:1.875rem;line-height:2.25rem}.loftrest .md\:lr-text-5xl{font-size:3rem;line-height:1}}
</style>

<div class="loftrest" id="loftrest-{{ section.id }}">
{%- assign faqs = section.blocks | where: 'type', 'faq' -%}
{%- assign categories = '' -%}
{%- for block in faqs -%}
  {%- assign cat = block.settings.category | strip | default: 'General' -%}
  {%- assign wrapped = '|' | append: cat | append: '|' -%}
  {%- assign haystack = '|' | append: categories | append: '|' -%}
  {%- unless haystack contains wrapped -%}
    {%- if categories == '' -%}{%- assign categories = cat -%}{%- else -%}{%- assign categories = categories | append: '|' | append: cat -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign category_list = categories | split: '|' -%}
{%- assign support_email = section.settings.support_email | default: shop.email -%}
{%- assign product = section.settings.product -%}

<div class="lr-pb-16">
  <!-- HEADER -->
  <header class="lr-bg-brand-navy lr-text-white">
    <div class="lr-max-w-4xl lr-mx-auto lr-px-4 lr-py-12 md:lr-py-16 lr-text-center">
      <p class="lr-text-sky-400 lr-font-bold lr-text-sm lr-uppercase lr-tracking-wide">Help centre</p>
      <h1 class="lr-mt-3 lr-text-3xl md:lr-text-5xl lr-font-extrabold lr-tracking-tight">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}<p class="lr-mt-4 lr-text-lg lr-text-slate-300 lr-max-w-2xl lr-mx-auto">{{ section.settings.intro | escape }}</p>{%- endif -%}
      {%- if category_list.size > 1 -%}
      <nav class="lr-mt-8 lr-flex lr-flex-wrap lr-justify-center lr-gap-2" aria-label="Question topics">
        {%- for cat in category_list -%}
        <a href="#topic-{{ cat | handleize }}" class="lr-rounded-full lr-bg-white/10 hover:lr-bg-white/20 lr-px-4 lr-py-2 lr-text-sm lr-font-semibold lr-transition-colors">{{ cat | escape }}</a>
        {%- endfor -%}
      </nav>
      {%- endif -%}
    </div>
  </header>

  <!-- QUESTIONS BY TOPIC -->
  <div class="lr-max-w-3xl lr-mx-auto lr-px-4">
    {%- for cat in category_list -%}
    <section id="topic-{{ cat | handleize }}" class="lr-pt-12 lr-scroll-mt-20">
      <h2 class="lr-text-2xl md:lr-text-3xl lr-font-extrabold lr-text-brand-navy lr-tracking-tight">{{ cat | escape }}</h2>
      <div class="lr-mt-6 lr-space-y-3">
        {%- for block in faqs -%}
          {%- assign block_cat = block.settings.category | strip | default: 'General' -%}
          {%- if block_cat == cat -%}
          <details class="lr-group lr-rounded-xl lr-border lr-border-slate-200 lr-bg-white lr-p-5" {{ block.shopify_attributes }}>
            <summary class="lr-flex lr-items-center lr-justify-between lr-gap-4 lr-cursor-pointer lr-font-bold lr-text-brand-navy lr-list-none">
              <h3>{{ block.settings.question | escape }}</h3>
              <svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-transition-transform group-open:lr-rotate-180" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <p class="lr-mt-3 lr-text-slate-600 lr-leading-relaxed lr-whitespace-pre-line">{{ block.settings.answer | escape }}</p>
          </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
    {%- endfor -%}
  </div>

  <!-- STILL HAVE A QUESTION? -->
  <section class="lr-max-w-3xl lr-mx-auto lr-px-4 lr-pt-16">
    <div class="lr-rounded-3xl lr-bg-brand-lightBlue lr-p-6 md:lr-p-10 lr-grid lr-grid-cols-1 md:lr-grid-cols-2 lr-gap-6 lr-items-center">
      <div>
        <h2 class="lr-text-2xl lr-font-extrabold lr-text-brand-navy">Still have a question?</h2>
        <p class="lr-mt-2 lr-text-slate-700">We're happy to help before and after you buy.</p>
      </div>
      <ul class="lr-space-y-3 lr-text-slate-700">
        {%- if support_email != blank -%}
        <li class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg> <a href="mailto:{{ support_email }}" class="lr-underline lr-font-semibold">{{ support_email }}</a></li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
        <li class="lr-flex lr-items-center lr-gap-3"><svg class="lr-w-5 lr-h-5 lr-shrink-0 lr-text-brand-blue" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" /></svg> <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="lr-underline lr-font-semibold">{{ section.settings.phone | escape }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </section>

  <!-- POLICIES -->
  {%- if shop.shipping_policy.url != blank or shop.refund_policy.url != blank or shop.terms_of_service.url != blank -%}
  <section class="lr-max-w-3xl lr-mx-auto lr-px-4 lr-pt-8">
    <ul class="lr-flex lr-flex-wrap lr-justify-center lr-gap-x-6 lr-gap-y-2 lr-text-sm lr-text-slate-600">
      {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}" class="lr-underline">Shipping policy</a></li>{%- endif -%}
      {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}" class="lr-underline">Refund policy</a></li>{%- endif -%}
      {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}" class="lr-underline">Terms of service</a></li>{%- endif -%}
      {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}" class="lr-underline">Privacy policy</a></li>{%- endif -%}
    </ul>
  </section>
  {%- endif -%}

  <!-- PRODUCT CTA -->
  {%- if product != blank -%}
  <section class="lr-max-w-3xl lr-mx-auto lr-px-4 lr-pt-12 lr-text-center">
    <h2 class="lr-text-2xl lr-font-extrabold lr-text-brand-navy">Ready to try LoftRest™?</h2>
    <p class="lr-mt-2 lr-text-slate-600">{{ product.selected_or_first_available_variant.price | money }} &middot; Free standard shipping in Australia &middot; 30-day returns</p>
    <a href="{{ product.url }}" class="lr-mt-5 lr-inline-block lr-bg-brand-blue hover:lr-bg-sky-600 lr-text-white lr-font-extrabold lr-px-8 lr-py-4 lr-rounded-xl lr-shadow-lg lr-transition-colors">Shop LoftRest™</a>
  </section>
  {%- endif -%}
</div>

{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faqs -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
</div>

{% schema %}
{
  "name": "LoftRest FAQ page",
  "tag": "div",
  "class": "loftrest-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Everything you need to know about LoftRest™, shipping and returns."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "info": "Leave empty to use your store email."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone (optional)"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product for the Shop button"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Topic",
          "info": "Questions with the same topic are grouped together, e.g. Shipping"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LoftRest FAQ page"
    }
  ]
}
{% endschema %}
